package searchhttp

import (
	"context"
	"encoding/json"
	"errors"
	"net/http"
	"net/http/httptest"
	"testing"

	"{{.module_path}}/internal/search"
	"github.com/gin-gonic/gin"
	"go.uber.org/zap"
)

type fakeService struct {
	result search.Result
	err    error
	query  string
	limit  int
	offset int
}

func (s *fakeService) Search(
	_ context.Context,
	query string,
	limit, offset int,
) (search.Result, error) {
	s.query = query
	s.limit = limit
	s.offset = offset

	return s.result, s.err
}

func TestHandlerSearch(t *testing.T) {
	t.Parallel()

	service := &fakeService{
		result: search.Result{
			Query:              "design",
			Hits:               []json.RawMessage{json.RawMessage(`{"id":"doc-1"}`)},
			EstimatedTotalHits: 1,
			Limit:              5,
			Offset:             2,
			ProcessingTimeMs:   3,
		},
	}
	router := newTestRouter(service)

	request := httptest.NewRequestWithContext(
		context.Background(),
		http.MethodGet,
		"/api/v1/search?q=design&limit=5&offset=2",
		nil,
	)
	recorder := httptest.NewRecorder()

	router.ServeHTTP(recorder, request)

	if recorder.Code != http.StatusOK {
		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusOK)
	}

	if service.query != "design" || service.limit != 5 || service.offset != 2 {
		t.Fatalf("service args = %q, %d, %d", service.query, service.limit, service.offset)
	}

	var response SearchResponse
	if err := json.NewDecoder(recorder.Body).Decode(&response); err != nil {
		t.Fatalf("decode response: %v", err)
	}

	if response.EstimatedTotalHits != 1 || len(response.Hits) != 1 {
		t.Fatalf("response = %#v", response)
	}
}

func TestHandlerSearchInvalidPagination(t *testing.T) {
	t.Parallel()

	router := newTestRouter(&fakeService{})
	request := httptest.NewRequestWithContext(
		context.Background(),
		http.MethodGet,
		"/api/v1/search?q=design&limit=no",
		nil,
	)
	recorder := httptest.NewRecorder()

	router.ServeHTTP(recorder, request)

	if recorder.Code != http.StatusUnprocessableEntity {
		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusUnprocessableEntity)
	}
}

func TestHandlerSearchUnavailable(t *testing.T) {
	t.Parallel()

	router := newTestRouter(&fakeService{err: search.ErrUnavailable})
	request := httptest.NewRequestWithContext(
		context.Background(),
		http.MethodGet,
		"/api/v1/search?q=design",
		nil,
	)
	recorder := httptest.NewRecorder()

	router.ServeHTTP(recorder, request)

	if recorder.Code != http.StatusServiceUnavailable {
		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusServiceUnavailable)
	}
}

func TestHandlerSearchValidationError(t *testing.T) {
	t.Parallel()

	router := newTestRouter(&fakeService{err: errors.Join(search.ErrInvalidInput, errors.New("bad query"))})
	request := httptest.NewRequestWithContext(
		context.Background(),
		http.MethodGet,
		"/api/v1/search",
		nil,
	)
	recorder := httptest.NewRecorder()

	router.ServeHTTP(recorder, request)

	if recorder.Code != http.StatusUnprocessableEntity {
		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusUnprocessableEntity)
	}
}

func newTestRouter(service ServiceContract) *gin.Engine {
	router := gin.New()
	NewHandler(service, zap.NewNop()).RegisterRoutes(router)

	return router
}
