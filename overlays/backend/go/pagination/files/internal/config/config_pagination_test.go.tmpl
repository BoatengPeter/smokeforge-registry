package config

import "testing"

const paginationFixtureSecret = "smokeforge-test-pagination-secret-32"

func validPaginationConfig() Config {
	config := validConfig()
	config.PaginationCursorSecret = paginationFixtureSecret
	config.PaginationDefaultLimit = 20
	config.PaginationMaxLimit = 100
	config.PaginationMaxOffset = 10000

	return config
}

func TestConfigValidatePagination(t *testing.T) {
	t.Parallel()

	tests := []struct {
		name    string
		mutate  func(*Config)
		wantErr bool
	}{
		{name: "valid", mutate: func(*Config) {}},
		{
			name:    "short secret",
			mutate:  func(config *Config) { config.PaginationCursorSecret = "short" },
			wantErr: true,
		},
		{
			name:    "default above max",
			mutate:  func(config *Config) { config.PaginationDefaultLimit = 101 },
			wantErr: true,
		},
		{
			name:    "max too high",
			mutate:  func(config *Config) { config.PaginationMaxLimit = 1001 },
			wantErr: true,
		},
		{
			name:    "zero max offset",
			mutate:  func(config *Config) { config.PaginationMaxOffset = 0 },
			wantErr: true,
		},
	}

	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			t.Parallel()

			config := validPaginationConfig()
			test.mutate(&config)

			err := config.Validate()
			if test.wantErr && err == nil {
				t.Fatal("expected error")
			}

			if !test.wantErr && err != nil {
				t.Fatalf("validate: %v", err)
			}
		})
	}
}
