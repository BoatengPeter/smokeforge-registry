// Package postgres persists media metadata in PostgreSQL.
package postgres

import (
	"context"
	"errors"
	"fmt"

	"{{.module_path}}/internal/media"
	"github.com/google/uuid"
	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgxpool"
)

const mediaColumns = `
	id, owner_id, object_key, content_type, byte_size, filename,
	status, created_at, updated_at`

// Repository stores media rows with an owned pgx pool.
type Repository struct {
	pool *pgxpool.Pool
}

// NewRepository constructs a media repository.
func NewRepository(pool *pgxpool.Pool) *Repository {
	return &Repository{pool: pool}
}

// Create inserts a pending media row.
func (r *Repository) Create(ctx context.Context, item media.Media) error {
	const query = `
		INSERT INTO media_objects (
			id, owner_id, object_key, content_type, byte_size, filename, status
		) VALUES ($1, $2, $3, $4, $5, $6, $7)`

	_, err := r.pool.Exec(
		ctx,
		query,
		item.ID,
		item.OwnerID,
		item.ObjectKey,
		item.ContentType,
		item.ByteSize,
		item.Filename,
		item.Status,
	)
	if err != nil {
		return fmt.Errorf("insert media: %w", err)
	}

	return nil
}

// Get returns one media row owned by ownerID.
func (r *Repository) Get(
	ctx context.Context,
	id, ownerID uuid.UUID,
) (media.Media, error) {
	query := `SELECT ` + mediaColumns + `
		FROM media_objects
		WHERE id = $1 AND owner_id = $2`

	item, err := scanMedia(r.pool.QueryRow(ctx, query, id, ownerID))
	if err != nil {
		if errors.Is(err, pgx.ErrNoRows) {
			return media.Media{}, media.ErrNotFound
		}

		return media.Media{}, fmt.Errorf("query media: %w", err)
	}

	return item, nil
}

// MarkReady transitions a pending row to ready and returns it.
func (r *Repository) MarkReady(
	ctx context.Context,
	id, ownerID uuid.UUID,
) (media.Media, error) {
	query := `UPDATE media_objects
		SET status = 'ready', updated_at = now()
		WHERE id = $1 AND owner_id = $2 AND status = 'pending'
		RETURNING ` + mediaColumns

	item, err := scanMedia(r.pool.QueryRow(ctx, query, id, ownerID))
	if err != nil {
		if errors.Is(err, pgx.ErrNoRows) {
			return media.Media{}, media.ErrNotFound
		}

		return media.Media{}, fmt.Errorf("mark media ready: %w", err)
	}

	return item, nil
}

// Delete removes one media row owned by ownerID.
func (r *Repository) Delete(ctx context.Context, id, ownerID uuid.UUID) error {
	tag, err := r.pool.Exec(
		ctx,
		`DELETE FROM media_objects WHERE id = $1 AND owner_id = $2`,
		id,
		ownerID,
	)
	if err != nil {
		return fmt.Errorf("delete media: %w", err)
	}

	if tag.RowsAffected() == 0 {
		return media.ErrNotFound
	}

	return nil
}

type rowScanner interface {
	Scan(dest ...any) error
}

func scanMedia(row rowScanner) (media.Media, error) {
	var item media.Media

	err := row.Scan(
		&item.ID,
		&item.OwnerID,
		&item.ObjectKey,
		&item.ContentType,
		&item.ByteSize,
		&item.Filename,
		&item.Status,
		&item.CreatedAt,
		&item.UpdatedAt,
	)
	if err != nil {
		return media.Media{}, err
	}

	return item, nil
}
