	return config.Config{
		MediaMaxBytes:            10 * 1024 * 1024,
		MediaS3Bucket:            "media",
		MediaS3Endpoint:          "http://localhost:9000",
		MediaS3PublicEndpoint:    "http://localhost:9000",
		MediaS3Region:            "us-east-1",
		MediaS3AccessKey:         "minioadmin",
		MediaS3SecretKey:         "minioadmin",
		MediaS3ForcePathStyle:    true,
		MediaAllowedContentTypes: []string{"image/jpeg", "image/png", "image/webp"},
		MediaUploadURLTTL:        15 * time.Minute,
		MediaDownloadURLTTL:      time.Hour,
	}
}

func TestServiceCreateUpload(t *testing.T) {
	t.Parallel()

	ownerID := uuid.New()
	repository := newFakeRepository()
	objects := &fakeObjects{
		target: UploadTarget{
			URL:       "https://uploads.example.test/signed",
			Headers:   map[string]string{"Content-Type": "image/png"},
			ExpiresIn: 900,
		},
	}
	service := NewService(repository, objects, testConfig(), zap.NewNop())

	upload, err := service.CreateUpload(context.Background(), ownerID, UploadInput{
		Filename:    "avatar.png",
		ContentType: "image/png",
		ByteSize:    2048,
	})
	if err != nil {
		t.Fatalf("create upload: %v", err)
	}

	if upload.Media.Status != StatusPending {
		t.Fatalf("status = %q, want pending", upload.Media.Status)
	}

	if upload.URL != objects.target.URL {
		t.Fatalf("url = %q", upload.URL)
	}

	if upload.Media.ObjectKey != "users/"+ownerID.String()+"/media/"+upload.Media.ID.String()+".png" {
		t.Fatalf("object key = %q", upload.Media.ObjectKey)
	}

	if len(repository.items) != 1 {
		t.Fatalf("repository size = %d, want 1", len(repository.items))
	}
}

func TestServiceCreateUploadValidation(t *testing.T) {
	t.Parallel()

	tests := []struct {
		name    string
		input   UploadInput
		wantErr error
	}{
		{
			name:    "empty filename",
			input:   UploadInput{Filename: " ", ContentType: "image/png", ByteSize: 1},
			wantErr: ErrInvalidInput,
		},
		{
			name:    "too large",
			input:   UploadInput{Filename: "x.png", ContentType: "image/png", ByteSize: 11 * 1024 * 1024},
			wantErr: ErrInvalidInput,
		},
		{
			name:    "unsupported type",
			input:   UploadInput{Filename: "x.pdf", ContentType: "application/pdf", ByteSize: 10},
			wantErr: ErrUnsupportedContentType,
		},
	}

	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			t.Parallel()

			service := NewService(
				newFakeRepository(),
				&fakeObjects{},
				testConfig(),
				zap.NewNop(),
			)

			_, err := service.CreateUpload(context.Background(), uuid.New(), test.input)
			if !errors.Is(err, test.wantErr) {
				t.Fatalf("error = %v, want %v", err, test.wantErr)
			}
		})
	}
}

func TestServiceComplete(t *testing.T) {
	t.Parallel()

	ownerID := uuid.New()
	item := Media{
		ID:          uuid.New(),
		OwnerID:     ownerID,
		ObjectKey:   "users/owner/media/image.png",
		ContentType: "image/png",
		ByteSize:    2048,
		Filename:    "avatar.png",
		Status:      StatusPending,
	}
	repository := newFakeRepository()
	repository.items[item.ID] = item
	objects := &fakeObjects{info: ObjectInfo{ByteSize: 2048, ContentType: "image/png"}}
	service := NewService(repository, objects, testConfig(), zap.NewNop())

	ready, err := service.Complete(context.Background(), ownerID, item.ID)
	if err != nil {
		t.Fatalf("complete: %v", err)
	}

	if ready.Status != StatusReady {
		t.Fatalf("status = %q, want ready", ready.Status)
	}
}

func TestServiceCompleteMismatch(t *testing.T) {
	t.Parallel()

	ownerID := uuid.New()
	item := Media{
		ID:          uuid.New(),
		OwnerID:     ownerID,
		ObjectKey:   "object",
		ContentType: "image/png",
		ByteSize:    2048,
		Status:      StatusPending,
	}
	repository := newFakeRepository()
	repository.items[item.ID] = item
	objects := &fakeObjects{info: ObjectInfo{ByteSize: 10, ContentType: "image/png"}}
	service := NewService(repository, objects, testConfig(), zap.NewNop())

	_, err := service.Complete(context.Background(), ownerID, item.ID)
	if !errors.Is(err, ErrSizeMismatch) {
		t.Fatalf("error = %v, want size mismatch", err)
	}
}

