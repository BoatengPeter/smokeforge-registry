type fakeRepository struct {
	items map[uuid.UUID]Media
}

func newFakeRepository() *fakeRepository {
	return &fakeRepository{items: map[uuid.UUID]Media{}}
}

func (r *fakeRepository) Create(_ context.Context, item Media) error {
	r.items[item.ID] = item

	return nil
}

func (r *fakeRepository) Get(_ context.Context, id, ownerID uuid.UUID) (Media, error) {
	item, ok := r.items[id]
	if !ok || item.OwnerID != ownerID {
		return Media{}, ErrNotFound
	}

	return item, nil
}

func (r *fakeRepository) MarkReady(_ context.Context, id, ownerID uuid.UUID) (Media, error) {
	item, ok := r.items[id]
	if !ok || item.OwnerID != ownerID {
		return Media{}, ErrNotFound
	}

	item.Status = StatusReady
	item.UpdatedAt = time.Now().UTC()
	r.items[id] = item

	return item, nil
}

func (r *fakeRepository) Delete(_ context.Context, id, ownerID uuid.UUID) error {
	item, ok := r.items[id]
	if !ok || item.OwnerID != ownerID {
		return ErrNotFound
	}

	delete(r.items, id)

	return nil
}

type fakeObjects struct {
	target   UploadTarget
	info     ObjectInfo
	infoErr  error
	getURL   string
	deleted  []string
	getCalls int
	headCall int
	putCalls int
}

func (s *fakeObjects) PresignPut(
	_ context.Context,
	_, _ string,
	_ time.Duration,
) (UploadTarget, error) {
	s.putCalls++

	return s.target, nil
}

func (s *fakeObjects) PresignGet(_ context.Context, _ string, _ time.Duration) (string, error) {
	s.getCalls++

	return s.getURL, nil
}

func (s *fakeObjects) Head(_ context.Context, _ string) (ObjectInfo, error) {
	s.headCall++

	return s.info, s.infoErr
}

func (s *fakeObjects) Delete(_ context.Context, key string) error {
	s.deleted = append(s.deleted, key)

	return nil
}

type fakeBuilder struct {
	key       string
	transform Transform
}

func (b *fakeBuilder) BuildURL(objectKey string, transform Transform) (string, error) {
	b.key = objectKey
	b.transform = transform

	return "https://cdn.example.test/image.webp", nil
}

