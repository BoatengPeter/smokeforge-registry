func TestServiceURLTransform(t *testing.T) {
	t.Parallel()

	ownerID := uuid.New()
	item := Media{
		ID:        uuid.New(),
		OwnerID:   ownerID,
		ObjectKey: "object",
		Status:    StatusReady,
	}
	repository := newFakeRepository()
	repository.items[item.ID] = item
	builder := &fakeBuilder{}
	service := NewService(repository, &fakeObjects{}, testConfig(), zap.NewNop())
	service.SetURLBuilder(builder)

	transform := Transform{Width: 200, Height: 100, Fit: "cover", Format: "webp"}

	imageURL, err := service.URL(context.Background(), ownerID, item.ID, transform)
	if err != nil {
		t.Fatalf("url: %v", err)
	}

	if imageURL.URL != "https://cdn.example.test/image.webp" {
		t.Fatalf("url = %q", imageURL.URL)
	}

	if builder.key != item.ObjectKey || builder.transform != transform {
		t.Fatalf("builder = %#v", builder)
	}
}

func TestServiceURLUnsupportedTransform(t *testing.T) {
	t.Parallel()

	ownerID := uuid.New()
	item := Media{ID: uuid.New(), OwnerID: ownerID, Status: StatusReady}
	repository := newFakeRepository()
	repository.items[item.ID] = item
	service := NewService(repository, &fakeObjects{}, testConfig(), zap.NewNop())

	_, err := service.URL(context.Background(), ownerID, item.ID, Transform{Width: 10})
	if !errors.Is(err, ErrUnsupportedTransform) {
		t.Fatalf("error = %v, want unsupported transform", err)
	}
}

func TestServiceDelete(t *testing.T) {
	t.Parallel()

	ownerID := uuid.New()
	item := Media{ID: uuid.New(), OwnerID: ownerID, ObjectKey: "object", Status: StatusReady}
	repository := newFakeRepository()
	repository.items[item.ID] = item
	objects := &fakeObjects{}
	service := NewService(repository, objects, testConfig(), zap.NewNop())

	if err := service.Delete(context.Background(), ownerID, item.ID); err != nil {
		t.Fatalf("delete: %v", err)
	}

	if len(objects.deleted) != 1 || objects.deleted[0] != item.ObjectKey {
		t.Fatalf("deleted = %#v", objects.deleted)
	}

	if len(repository.items) != 0 {
		t.Fatalf("repository size = %d, want 0", len(repository.items))
	}
}
