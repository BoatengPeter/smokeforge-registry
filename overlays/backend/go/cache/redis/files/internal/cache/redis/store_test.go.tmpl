package rediscache

import (
	"context"
	"errors"
	"testing"
	"time"

	"{{.module_path}}/internal/cache"
	"{{.module_path}}/internal/config"
	"github.com/alicebob/miniredis/v2"
)

func newTestStore(t *testing.T) (*Store, *miniredis.Miniredis) {
	t.Helper()

	server, err := miniredis.Run()
	if err != nil {
		t.Fatalf("start miniredis: %v", err)
	}

	cfg := config.Config{
		ServiceName:       "test-service",
		RedisURL:          "redis://" + server.Addr() + "/0",
		RedisDialTimeout:  time.Second,
		RedisReadTimeout:  time.Second,
		RedisWriteTimeout: time.Second,
		RedisPoolSize:     2,
		RedisMinIdleConns: 1,
		RedisMaxRetries:   1,
	}

	store, err := New(cfg)
	if err != nil {
		server.Close()

		t.Fatalf("new store: %v", err)
	}

	t.Cleanup(func() {
		_ = store.Close()
		server.Close()
	})

	return store, server
}

func TestStoreSetGetDelete(t *testing.T) {
	t.Parallel()

	store, server := newTestStore(t)
	ctx := context.Background()

	if err := store.Set(ctx, "user:1", []byte("value"), time.Minute); err != nil {
		t.Fatalf("set: %v", err)
	}

	if !server.Exists("test-service:user:1") {
		t.Fatal("namespaced key was not written")
	}

	value, found, err := store.Get(ctx, "user:1")
	if err != nil {
		t.Fatalf("get: %v", err)
	}

	if !found || string(value) != "value" {
		t.Fatalf("value = %q, found = %t", value, found)
	}

	if err := store.Delete(ctx, "user:1"); err != nil {
		t.Fatalf("delete: %v", err)
	}

	_, found, err = store.Get(ctx, "user:1")
	if err != nil {
		t.Fatalf("get after delete: %v", err)
	}

	if found {
		t.Fatal("deleted key was still found")
	}
}

func TestStoreExpiresValues(t *testing.T) {
	t.Parallel()

	store, server := newTestStore(t)
	ctx := context.Background()

	if err := store.Set(ctx, "short", []byte("value"), time.Minute); err != nil {
		t.Fatalf("set: %v", err)
	}

	server.FastForward(2 * time.Minute)

	_, found, err := store.Get(ctx, "short")
	if err != nil {
		t.Fatalf("get: %v", err)
	}

	if found {
		t.Fatal("expired key was still found")
	}
}

func TestStoreRejectsInvalidInput(t *testing.T) {
	t.Parallel()

	store, _ := newTestStore(t)
	ctx := context.Background()

	if err := store.Set(ctx, "", []byte("value"), time.Minute); !errors.Is(err, cache.ErrInvalidKey) {
		t.Fatalf("empty key error = %v", err)
	}

	if err := store.Set(ctx, "key", []byte("value"), 0); !errors.Is(err, cache.ErrInvalidTTL) {
		t.Fatalf("zero ttl error = %v", err)
	}

	if _, _, err := store.Get(ctx, ""); !errors.Is(err, cache.ErrInvalidKey) {
		t.Fatalf("get empty key error = %v", err)
	}
}

func TestStorePing(t *testing.T) {
	t.Parallel()

	store, _ := newTestStore(t)

	if err := store.Ping(context.Background()); err != nil {
		t.Fatalf("ping: %v", err)
	}
}
