// Package main starts the queue scheduler process.
package main

import (
	"context"
	"fmt"
	"os"
	"os/signal"
	"syscall"

	"{{.module_path}}/internal/config"
	"{{.module_path}}/internal/logging"
	"{{.module_path}}/internal/queue/rabbitmq"

	// smokeforge:anchor import-compression
	"{{.module_path}}/internal/scheduler"
	"go.uber.org/zap"
)

func main() {
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

func run() error {
	cfg, err := config.Load()
	if err != nil {
		return fmt.Errorf("load config: %w", err)
	}

	logger, err := logging.New(cfg)
	if err != nil {
		return err
	}

	defer func() {
		_ = logger.Sync()
	}()

	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()

	manager, err := rabbitmq.NewConnectionManager(ctx, cfg, logger)
	if err != nil {
		return fmt.Errorf("connect rabbitmq: %w", err)
	}

	defer func() {
		_ = manager.Close()
	}()

	if err := rabbitmq.EnsureTopology(ctx, manager, cfg); err != nil {
		return fmt.Errorf("declare rabbitmq topology: %w", err)
	}

	publisher := rabbitmq.NewPublisher(manager, cfg, logger)
	// smokeforge:anchor scheduler-codec

	defer func() {
		_ = publisher.Close()
	}()

	var leader scheduler.LeaderElector
	// smokeforge:anchor scheduler-leader
	leader = scheduler.OrDefault(leader, scheduler.AlwaysLeader{})

	logger.Info("scheduler started", zap.String("heartbeat", cfg.SchedulerHeartbeat))

	schedulerRunner := scheduler.New(cfg, logger, publisher, leader)

	if err := schedulerRunner.Run(ctx); err != nil {
		return fmt.Errorf("run scheduler: %w", err)
	}

	return nil
}
