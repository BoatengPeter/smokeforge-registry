package heartbeat

import (
	"context"
	"testing"
	"time"

	"go.uber.org/zap"
)

func TestNewJob(t *testing.T) {
	t.Parallel()

	now := time.Date(2026, 11, 14, 12, 0, 0, 0, time.UTC)

	job, err := NewJob(now)
	if err != nil {
		t.Fatalf("new job: %v", err)
	}

	if err := job.Validate(); err != nil {
		t.Fatalf("validate: %v", err)
	}

	if job.Type != Type || job.Attempt != 0 {
		t.Fatalf("job = %+v", job)
	}
}

func TestHandler(t *testing.T) {
	t.Parallel()

	job, err := NewJob(time.Now())
	if err != nil {
		t.Fatalf("new job: %v", err)
	}

	if err := NewHandler(zap.NewNop()).Handle(context.Background(), job); err != nil {
		t.Fatalf("handle: %v", err)
	}
}
