// Package googleauth adapts Gothic's Google provider to auth identities.
package googleauth

import (
	"errors"
	"fmt"
	"net/http"
	"strings"
	"time"

	"{{.module_path}}/internal/auth"
	"{{.module_path}}/internal/config"
	"github.com/gorilla/sessions"
	"github.com/markbates/goth"
	"github.com/markbates/goth/gothic"
	"github.com/markbates/goth/providers/google"
)

const providerName = "google"

// Provider wraps Gothic's Google provider and its cookie session store.
type Provider struct {
	successRedirect string
}

// New constructs the Google provider or returns nil when it is disabled.
func New(cfg config.Config) (*Provider, error) {
	if cfg.GoogleClientID == "" && cfg.GoogleClientSecret == "" {
		return nil, nil
	}

	if cfg.GoogleClientID == "" || cfg.GoogleClientSecret == "" {
		return nil, errors.New("auth: google client id and secret must be set together")
	}

	redirectURL := cfg.GoogleRedirectURL
	if redirectURL == "" {
		redirectURL = strings.TrimRight(cfg.PublicBaseURL, "/") + "/api/v1/auth/oauth/google/callback"
	}

	store := sessions.NewCookieStore([]byte(cfg.JWTSecret))
	store.Options = &sessions.Options{
		Path:     "/api/v1/auth/oauth/google",
		MaxAge:   int((10 * time.Minute).Seconds()),
		HttpOnly: true,
		Secure:   cfg.CookieSecure,
		SameSite: http.SameSiteLaxMode,
	}

	gothic.Store = store

	goth.UseProviders(google.New(
		cfg.GoogleClientID,
		cfg.GoogleClientSecret,
		redirectURL,
		"email",
		"profile",
	))

	successRedirect := cfg.OAuthSuccessRedirect
	if successRedirect == "" {
		successRedirect = cfg.PublicBaseURL
	}

	return &Provider{successRedirect: successRedirect}, nil
}

// SuccessRedirect returns the URL to use after a successful callback.
func (p *Provider) SuccessRedirect() string {
	return p.successRedirect
}

// Begin redirects the browser to Google and stores the OAuth state.
func (p *Provider) Begin(w http.ResponseWriter, r *http.Request) error {
	request := gothic.GetContextWithProvider(r, providerName)

	authURL, err := gothic.GetAuthURL(w, request)
	if err != nil {
		return fmt.Errorf("begin google oauth: %w", err)
	}

	http.Redirect(w, request, authURL, http.StatusTemporaryRedirect)

	return nil
}

// Complete validates the callback and returns the Google identity.
func (p *Provider) Complete(
	w http.ResponseWriter,
	r *http.Request,
) (auth.ExternalIdentity, error) {
	profile, err := gothic.CompleteUserAuth(w, gothic.GetContextWithProvider(r, providerName))
	if err != nil {
		return auth.ExternalIdentity{}, fmt.Errorf("complete google oauth: %w", err)
	}

	return externalIdentity(profile)
}

func externalIdentity(profile goth.User) (auth.ExternalIdentity, error) {
	if profile.UserID == "" {
		return auth.ExternalIdentity{}, auth.ErrInvalidExternalIdentity
	}

	if verified, ok := profile.RawData["verified_email"].(bool); ok && !verified {
		return auth.ExternalIdentity{}, auth.ErrEmailNotVerified
	}

	return auth.ExternalIdentity{
		Provider:   providerName,
		ProviderID: profile.UserID,
		Email:      profile.Email,
	}, nil
}
