package auth

import (
	"context"
	"strings"

	"{{.module_path}}/internal/response"
	"github.com/gin-gonic/gin"
)

type identityContextKey string

const identityKey identityContextKey = "auth.identity"

// TokenVerifier validates access tokens for authenticated routes.
type TokenVerifier interface {
	Authenticate(ctx context.Context, raw string) (Identity, error)
}

// RequireAuth rejects requests without a valid Bearer access token.
func RequireAuth(verifier TokenVerifier) gin.HandlerFunc {
	return func(c *gin.Context) {
		identity, err := verifier.Authenticate(c.Request.Context(), bearerToken(c))
		if err != nil {
			response.WriteUnauthorized(c, "A valid access token is required.")

			return
		}

		c.Set(string(identityKey), identity)
		c.Next()
	}
}

// IdentityFromContext returns the authenticated principal.
func IdentityFromContext(c *gin.Context) (Identity, bool) {
	value, ok := c.Get(string(identityKey))
	if !ok {
		return Identity{}, false
	}

	identity, ok := value.(Identity)

	return identity, ok
}

func bearerToken(c *gin.Context) string {
	parts := strings.Fields(c.GetHeader("Authorization"))
	if len(parts) != 2 || !strings.EqualFold(parts[0], "Bearer") {
		return ""
	}

	return parts[1]
}
