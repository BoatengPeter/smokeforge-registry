type stubGoogleOAuth struct{}

func (stubGoogleOAuth) Begin(writer http.ResponseWriter, _ *http.Request) error {
	writer.Header().Set("Location", "https://accounts.google.com/o/oauth2/auth")
	writer.WriteHeader(http.StatusTemporaryRedirect)

	return nil
}

func (stubGoogleOAuth) Complete(
	_ http.ResponseWriter,
	_ *http.Request,
) (auth.ExternalIdentity, error) {
	return auth.ExternalIdentity{
		Provider:   "google",
		ProviderID: "google-123",
		Email:      "user@example.com",
	}, nil
}

func (stubGoogleOAuth) SuccessRedirect() string { return "http://localhost:8080" }

func newAuthRouter(t *testing.T, service ServiceContract, google GoogleOAuth) *gin.Engine {
	t.Helper()

	gin.SetMode(gin.TestMode)

	cfg := config.Config{
		RefreshTokenTTL:          time.Hour,
		CookieSecure:             false,
		PublicBaseURL:            "http://localhost:8080",
		RequireEmailVerification: "false",
	}

	router := gin.New()
	NewHandler(service, google, cfg, zap.NewNop()).RegisterRoutes(router)

	return router
}

func TestHandlerLoginCookieTransport(t *testing.T) {
	t.Parallel()

	service := stubAuthService{
		loginResult: auth.LoginResult{Tokens: &auth.TokenPair{
			AccessToken:  "access",
			RefreshToken: "refresh",
			ExpiresIn:    900,
		}},
	}
	router := newAuthRouter(t, service, nil)
	request := httptest.NewRequestWithContext(
		context.Background(),
		http.MethodPost,
		"/api/v1/auth/login",
		strings.NewReader(`{"email":"user@example.com","password":"correct horse battery"}`),
	)
	request.Header.Set("Content-Type", "application/json")

	response := httptest.NewRecorder()

	router.ServeHTTP(response, request)

	if response.Code != http.StatusOK {
		t.Fatalf("status = %d, want 200", response.Code)
	}

	var body TokenResponse
	if err := json.Unmarshal(response.Body.Bytes(), &body); err != nil {
		t.Fatalf("decode token response: %v", err)
	}

	if body.RefreshToken != nil {
		t.Fatal("cookie transport returned refresh token in body")
	}

	if cookie := response.Header().Get("Set-Cookie"); !strings.Contains(cookie, refreshCookieName) {
		t.Fatalf("set-cookie = %q", cookie)
	}
}

func TestHandlerLoginNativeTransport(t *testing.T) {
	t.Parallel()

	service := stubAuthService{
		loginResult: auth.LoginResult{Tokens: &auth.TokenPair{
			AccessToken:  "access",
			RefreshToken: "refresh",
			ExpiresIn:    900,
		}},
	}
	router := newAuthRouter(t, service, nil)
	request := httptest.NewRequestWithContext(
		context.Background(),
		http.MethodPost,
		"/api/v1/auth/login",
		strings.NewReader(`{"email":"user@example.com","password":"correct horse battery"}`),
	)
	request.Header.Set("Content-Type", "application/json")
	request.Header.Set(refreshBodyHeader, "body")

	response := httptest.NewRecorder()

	router.ServeHTTP(response, request)

	var body TokenResponse
	if err := json.Unmarshal(response.Body.Bytes(), &body); err != nil {
		t.Fatalf("decode token response: %v", err)
	}

	if body.RefreshToken == nil || *body.RefreshToken != "refresh" {
		t.Fatalf("refresh token = %v", body.RefreshToken)
	}
}

func TestHandlerRefreshCookieRequiresCSRFHeader(t *testing.T) {
	t.Parallel()

	router := newAuthRouter(t, stubAuthService{}, nil)
	request := httptest.NewRequestWithContext(context.Background(), http.MethodPost, "/api/v1/auth/refresh", nil)
	request.AddCookie(&http.Cookie{Name: refreshCookieName, Value: "refresh"})

	response := httptest.NewRecorder()

	router.ServeHTTP(response, request)

	if response.Code != http.StatusForbidden {
		t.Fatalf("status = %d, want 403", response.Code)
	}
}

