// Package auth implements authentication, accounts, sessions, and identity.
package auth

import (
	"context"
	"errors"
	"fmt"
	"net/mail"
	"strings"

	"{{.module_path}}/internal/config"
	"github.com/google/uuid"
	"go.uber.org/zap"
)

// Service implements registration, login, refresh, recovery, and identity.
type Service struct {
	store        Store
	tokens       *TokenService
	email        EmailSender
	config       config.Config
	logger       *zap.Logger
	dummyHash    string
	secondFactor SecondFactor
}

// NewService constructs the auth service.
func NewService(
	store Store,
	cfg config.Config,
	logger *zap.Logger,
	email EmailSender,
) (*Service, error) {
	dummyHash, err := HashPassword("smokeforge-dummy-password")
	if err != nil {
		return nil, fmt.Errorf("prepare password verifier: %w", err)
	}

	return &Service{
		store:     store,
		tokens:    NewTokenService(cfg),
		email:     email,
		config:    cfg,
		logger:    logger,
		dummyHash: dummyHash,
	}, nil
}

// SetSecondFactor enables TOTP completion during login.
func (s *Service) SetSecondFactor(secondFactor SecondFactor) {
	s.secondFactor = secondFactor
}

// Register creates an account and optionally sends a verification email.
func (s *Service) Register(ctx context.Context, email, password string) (Account, error) {
	email, err := normalizeEmail(email)
	if err != nil {
		return Account{}, err
	}

	if err := validatePassword(password); err != nil {
		return Account{}, err
	}

	passwordHash, err := HashPassword(password)
	if err != nil {
		return Account{}, err
	}

	userID, err := uuid.NewV7()
	if err != nil {
		return Account{}, fmt.Errorf("generate user id: %w", err)
	}

	user, err := s.store.CreateUser(ctx, userID, email, passwordHash, "user")
	if err != nil {
		return Account{}, err
	}

	if s.requireEmailVerification() {
		if err := s.sendVerification(ctx, user); err != nil {
			s.logger.Error("send verification email", zap.Error(err), zap.String("user_id", user.ID.String()))
		}
	}

	return user.account(), nil
}

// Login verifies credentials and returns tokens or an MFA challenge.
func (s *Service) Login(ctx context.Context, email, password string) (LoginResult, error) {
	email, err := normalizeEmail(email)
	if err != nil {
		return LoginResult{}, ErrInvalidCredentials
	}

	user, err := s.store.GetUserByEmail(ctx, email)
	if errors.Is(err, ErrNotFound) {
		_, _ = VerifyPassword(password, s.dummyHash)

		return LoginResult{}, ErrInvalidCredentials
	}

	if err != nil {
		return LoginResult{}, err
	}

	valid, err := VerifyPassword(password, user.PasswordHash)
	if err != nil || !valid {
		return LoginResult{}, ErrInvalidCredentials
	}

	if s.requireEmailVerification() && user.EmailVerifiedAt == nil {
		return LoginResult{}, ErrEmailNotVerified
	}

	if s.secondFactor != nil {
		required, requiredErr := s.secondFactor.Required(ctx, user.ID)
		if requiredErr != nil {
			return LoginResult{}, fmt.Errorf("check second factor: %w", requiredErr)
		}

		if required {
			challenge, expiresIn, issueErr := s.tokens.IssueMFA(user.ID)
			if issueErr != nil {
				return LoginResult{}, issueErr
			}

			return LoginResult{MFAChallenge: challenge, MFAExpiresIn: expiresIn}, nil
		}
	}

	pair, err := s.issueTokenPair(ctx, user.account())
	if err != nil {
		return LoginResult{}, err
	}

	return LoginResult{Tokens: &pair}, nil
}

// CompleteMFA verifies a TOTP or recovery code and issues tokens.
func (s *Service) CompleteMFA(ctx context.Context, challenge, code string) (TokenPair, error) {
	if s.secondFactor == nil {
		return TokenPair{}, ErrMFAUnavailable
	}

	userID, err := s.tokens.ParseMFA(challenge)
	if err != nil {
		return TokenPair{}, ErrInvalidToken
	}

	if err := s.secondFactor.Verify(ctx, userID, code); err != nil {
		return TokenPair{}, err
	}

	user, err := s.store.GetUserByID(ctx, userID)
	if err != nil {
		return TokenPair{}, err
	}

	return s.issueTokenPair(ctx, user.account())
}

// Authenticate verifies an access token.
func (s *Service) Authenticate(_ context.Context, raw string) (Identity, error) {
	return s.tokens.ParseAccess(raw)
}

// GetUser returns the public account for an authenticated identity.
func (s *Service) GetUser(ctx context.Context, id uuid.UUID) (Account, error) {
	user, err := s.store.GetUserByID(ctx, id)
	if err != nil {
		return Account{}, err
	}

	return user.account(), nil
}

func (s *Service) requireEmailVerification() bool {
	switch s.config.RequireEmailVerification {
	case "true":
		return true
	case "false":
		return false
	default:
		return s.config.IsProduction()
	}
}

func normalizeEmail(value string) (string, error) {
	value = strings.TrimSpace(value)

	address, err := mail.ParseAddress(value)
	if err != nil || address.Name != "" {
		return "", ErrInvalidEmail
	}

	return strings.ToLower(address.Address), nil
}
