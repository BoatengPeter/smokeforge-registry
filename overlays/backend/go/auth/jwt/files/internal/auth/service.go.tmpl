package auth

import (
	"context"
	"errors"
	"fmt"
	"net/http"
	"net/mail"
	"net/url"
	"strings"
	"time"

	"{{.module_path}}/internal/config"
	"github.com/google/uuid"
	"github.com/jackc/pgx/v5"
	"github.com/markbates/goth"
	"go.uber.org/zap"
)

// Service implements registration, login, refresh, recovery, and identity.
type Service struct {
	store        Store
	tokens       *TokenService
	email        EmailSender
	config       config.Config
	logger       *zap.Logger
	dummyHash    string
	secondFactor SecondFactor
	google       *GoogleProvider
}

// NewService constructs the auth service.
func NewService(
	store Store,
	cfg config.Config,
	logger *zap.Logger,
	email EmailSender,
) (*Service, error) {
	dummyHash, err := HashPassword("smokeforge-dummy-password")
	if err != nil {
		return nil, fmt.Errorf("prepare password verifier: %w", err)
	}

	googleProvider, err := newGoogleProvider(cfg)
	if err != nil {
		return nil, err
	}

	return &Service{
		store:     store,
		tokens:    NewTokenService(cfg),
		email:     email,
		config:    cfg,
		logger:    logger,
		dummyHash: dummyHash,
		google:    googleProvider,
	}, nil
}

// SetSecondFactor enables TOTP completion during login.
func (s *Service) SetSecondFactor(secondFactor SecondFactor) {
	s.secondFactor = secondFactor
}

// Register creates an account and optionally sends a verification email.
func (s *Service) Register(ctx context.Context, email, password string) (Account, error) {
	email, err := normalizeEmail(email)
	if err != nil {
		return Account{}, err
	}

	if err := validatePassword(password); err != nil {
		return Account{}, err
	}

	passwordHash, err := HashPassword(password)
	if err != nil {
		return Account{}, err
	}

	userID, err := uuid.NewV7()
	if err != nil {
		return Account{}, fmt.Errorf("generate user id: %w", err)
	}

	user, err := s.store.CreateUser(ctx, userID, email, passwordHash, "user")
	if err != nil {
		return Account{}, err
	}

	if s.requireEmailVerification() {
		if err := s.sendVerification(ctx, user); err != nil {
			s.logger.Error("send verification email", zap.Error(err), zap.String("user_id", user.ID.String()))
		}
	}

	return user.account(), nil
}

// Login verifies credentials and returns tokens or an MFA challenge.
func (s *Service) Login(ctx context.Context, email, password string) (LoginResult, error) {
	email, err := normalizeEmail(email)
	if err != nil {
		return LoginResult{}, ErrInvalidCredentials
	}

	user, err := s.store.GetUserByEmail(ctx, email)
	if errors.Is(err, pgx.ErrNoRows) {
		_, _ = VerifyPassword(password, s.dummyHash)

		return LoginResult{}, ErrInvalidCredentials
	}

	if err != nil {
		return LoginResult{}, err
	}

	valid, err := VerifyPassword(password, user.PasswordHash)
	if err != nil || !valid {
		return LoginResult{}, ErrInvalidCredentials
	}

	if s.requireEmailVerification() && user.EmailVerifiedAt == nil {
		return LoginResult{}, ErrEmailNotVerified
	}

	if s.secondFactor != nil {
		required, requiredErr := s.secondFactor.Required(ctx, user.ID)
		if requiredErr != nil {
			return LoginResult{}, fmt.Errorf("check second factor: %w", requiredErr)
		}

		if required {
			challenge, expiresIn, issueErr := s.tokens.IssueMFA(user.ID)
			if issueErr != nil {
				return LoginResult{}, issueErr
			}

			return LoginResult{MFAChallenge: challenge, MFAExpiresIn: expiresIn}, nil
		}
	}

	pair, err := s.issueTokenPair(ctx, user.account())
	if err != nil {
		return LoginResult{}, err
	}

	return LoginResult{Tokens: &pair}, nil
}

// CompleteMFA verifies a TOTP or recovery code and issues tokens.
func (s *Service) CompleteMFA(ctx context.Context, challenge, code string) (TokenPair, error) {
	if s.secondFactor == nil {
		return TokenPair{}, ErrMFAUnavailable
	}

	userID, err := s.tokens.ParseMFA(challenge)
	if err != nil {
		return TokenPair{}, ErrInvalidToken
	}

	if err := s.secondFactor.Verify(ctx, userID, code); err != nil {
		return TokenPair{}, err
	}

	user, err := s.store.GetUserByID(ctx, userID)
	if err != nil {
		return TokenPair{}, err
	}

	return s.issueTokenPair(ctx, user.account())
}

// GoogleEnabled reports whether Google OAuth is configured.
func (s *Service) GoogleEnabled() bool {
	return s.google != nil
}

// BeginGoogle redirects the browser to Google.
func (s *Service) BeginGoogle(w http.ResponseWriter, r *http.Request) error {
	if s.google == nil {
		return errors.New("auth: google oauth is not configured")
	}

	return s.google.Begin(w, r)
}

// GoogleSuccessRedirect returns the URL to use after Google OAuth completes.
func (s *Service) GoogleSuccessRedirect() string {
	if s.google == nil {
		return s.config.PublicBaseURL
	}

	return s.google.SuccessRedirect()
}

// LoginWithGoogle completes Google OAuth, links the account, and issues tokens.
func (s *Service) LoginWithGoogle(ctx context.Context, w http.ResponseWriter, r *http.Request) (TokenPair, error) {
	if s.google == nil {
		return TokenPair{}, errors.New("auth: google oauth is not configured")
	}

	profile, err := s.google.Complete(w, r)
	if err != nil {
		return TokenPair{}, err
	}

	return s.loginWithGoogleProfile(ctx, profile)
}

func (s *Service) loginWithGoogleProfile(ctx context.Context, profile goth.User) (TokenPair, error) {
	email, err := validateGoogleProfile(profile)
	if err != nil {
		return TokenPair{}, err
	}

	user, err := s.resolveGoogleUser(ctx, profile, email)
	if err != nil {
		return TokenPair{}, err
	}

	return s.issueTokenPair(ctx, user.account())
}

func validateGoogleProfile(profile goth.User) (string, error) {
	if profile.UserID == "" {
		return "", errors.New("auth: google profile has no account id")
	}

	if verified, ok := profile.RawData["verified_email"].(bool); ok && !verified {
		return "", ErrEmailNotVerified
	}

	return normalizeEmail(profile.Email)
}

func (s *Service) resolveGoogleUser(
	ctx context.Context,
	profile goth.User,
	email string,
) (UserRecord, error) {
	userID, err := s.store.GetOAuthAccount(ctx, googleProvider, profile.UserID)
	if err == nil {
		return s.store.GetUserByID(ctx, userID)
	}

	if !errors.Is(err, pgx.ErrNoRows) {
		return UserRecord{}, err
	}

	user, err := s.store.GetUserByEmail(ctx, email)
	if errors.Is(err, pgx.ErrNoRows) {
		user, err = s.createGoogleUser(ctx, email)
	}

	if err != nil {
		return UserRecord{}, err
	}

	return s.linkGoogleAccount(ctx, user, profile, email)
}

func (s *Service) createGoogleUser(ctx context.Context, email string) (UserRecord, error) {
	randomPassword, _, err := NewOpaqueToken()
	if err != nil {
		return UserRecord{}, err
	}

	passwordHash, err := HashPassword(randomPassword)
	if err != nil {
		return UserRecord{}, err
	}

	userID, err := uuid.NewV7()
	if err != nil {
		return UserRecord{}, fmt.Errorf("generate user id: %w", err)
	}

	return s.store.CreateUser(ctx, userID, email, passwordHash, "user")
}

func (s *Service) linkGoogleAccount(
	ctx context.Context,
	user UserRecord,
	profile goth.User,
	email string,
) (UserRecord, error) {
	oauthID, err := uuid.NewV7()
	if err != nil {
		return UserRecord{}, fmt.Errorf("generate oauth account id: %w", err)
	}

	err = s.store.CreateOAuthAccount(ctx, oauthID, user.ID, googleProvider, profile.UserID, email)
	if err == nil {
		return user, nil
	}

	linkedUserID, lookupErr := s.store.GetOAuthAccount(ctx, googleProvider, profile.UserID)
	if lookupErr != nil {
		return UserRecord{}, err
	}

	return s.store.GetUserByID(ctx, linkedUserID)
}

// Refresh rotates a refresh token and issues a new access token.
func (s *Service) Refresh(ctx context.Context, raw string) (TokenPair, error) {
	token, err := s.refreshToken(ctx, raw)
	if err != nil {
		return TokenPair{}, err
	}

	affected, err := s.store.ConsumeToken(ctx, token.ID)
	if err != nil {
		return TokenPair{}, err
	}

	if affected == 0 {
		if revokeErr := s.store.RevokeUserTokens(ctx, token.UserID, tokenKindRefresh); revokeErr != nil {
			s.logger.Error("revoke reused refresh tokens", zap.Error(revokeErr))
		}

		return TokenPair{}, ErrInvalidToken
	}

	user, err := s.store.GetUserByID(ctx, token.UserID)
	if err != nil {
		return TokenPair{}, err
	}

	return s.issueTokenPair(ctx, user.account())
}

// Logout revokes a refresh token when it is present.
func (s *Service) Logout(ctx context.Context, raw string) {
	if raw == "" {
		return
	}

	token, err := s.store.GetTokenByHash(ctx, HashToken(raw))
	if err != nil {
		return
	}

	if token.Kind != tokenKindRefresh {
		return
	}

	if err := s.store.RevokeToken(ctx, token.ID); err != nil {
		s.logger.Error("revoke refresh token", zap.Error(err))
	}
}

// VerifyEmail consumes an email verification token.
func (s *Service) VerifyEmail(ctx context.Context, raw string) error {
	token, err := s.validToken(ctx, raw, tokenKindEmailVerify)
	if err != nil {
		return err
	}

	affected, err := s.store.ConsumeToken(ctx, token.ID)
	if err != nil {
		return err
	}

	if affected == 0 {
		return ErrInvalidToken
	}

	return s.store.MarkEmailVerified(ctx, token.UserID)
}

// ForgotPassword sends a reset email without revealing whether an account exists.
func (s *Service) ForgotPassword(ctx context.Context, email string) {
	email, err := normalizeEmail(email)
	if err != nil {
		return
	}

	user, err := s.store.GetUserByEmail(ctx, email)
	if err != nil {
		if !errors.Is(err, pgx.ErrNoRows) {
			s.logger.Error("look up password reset user", zap.Error(err))
		}

		return
	}

	if err := s.sendPasswordReset(ctx, user); err != nil {
		s.logger.Error("send password reset email", zap.Error(err), zap.String("user_id", user.ID.String()))
	}
}

// ResetPassword consumes a reset token and changes the password.
func (s *Service) ResetPassword(ctx context.Context, raw, password string) error {
	if err := validatePassword(password); err != nil {
		return err
	}

	token, err := s.validToken(ctx, raw, tokenKindPasswordReset)
	if err != nil {
		return err
	}

	affected, err := s.store.ConsumeToken(ctx, token.ID)
	if err != nil {
		return err
	}

	if affected == 0 {
		return ErrInvalidToken
	}

	passwordHash, err := HashPassword(password)
	if err != nil {
		return err
	}

	if err := s.store.UpdatePassword(ctx, token.UserID, passwordHash); err != nil {
		return err
	}

	if err := s.store.RevokeUserTokens(ctx, token.UserID, tokenKindRefresh); err != nil {
		return err
	}

	return nil
}

// Authenticate verifies an access token.
func (s *Service) Authenticate(_ context.Context, raw string) (Identity, error) {
	return s.tokens.ParseAccess(raw)
}

// GetUser returns the public account for an authenticated identity.
func (s *Service) GetUser(ctx context.Context, id uuid.UUID) (Account, error) {
	user, err := s.store.GetUserByID(ctx, id)
	if err != nil {
		return Account{}, err
	}

	return user.account(), nil
}

func (s *Service) issueTokenPair(ctx context.Context, account Account) (TokenPair, error) {
	accessToken, expiresIn, err := s.tokens.IssueAccess(account)
	if err != nil {
		return TokenPair{}, err
	}

	rawRefresh, hash, err := NewOpaqueToken()
	if err != nil {
		return TokenPair{}, err
	}

	tokenID, err := uuid.NewV7()
	if err != nil {
		return TokenPair{}, fmt.Errorf("generate refresh token id: %w", err)
	}

	if err := s.store.CreateToken(ctx, CreateTokenParams{
		ID:        tokenID,
		UserID:    account.ID,
		Kind:      tokenKindRefresh,
		TokenHash: hash,
		ExpiresAt: time.Now().UTC().Add(s.config.RefreshTokenTTL),
	}); err != nil {
		return TokenPair{}, err
	}

	return TokenPair{
		AccessToken:  accessToken,
		RefreshToken: rawRefresh,
		ExpiresIn:    expiresIn,
		Account:      account,
	}, nil
}

func (s *Service) refreshToken(ctx context.Context, raw string) (TokenRecord, error) {
	token, err := s.lookupToken(ctx, raw)
	if err != nil {
		return TokenRecord{}, err
	}

	if token.Kind != tokenKindRefresh {
		return TokenRecord{}, ErrInvalidToken
	}

	if token.UsedAt != nil {
		if revokeErr := s.store.RevokeUserTokens(ctx, token.UserID, tokenKindRefresh); revokeErr != nil {
			s.logger.Error("revoke reused refresh tokens", zap.Error(revokeErr))
		}

		return TokenRecord{}, ErrInvalidToken
	}

	if time.Now().UTC().After(token.ExpiresAt) {
		return TokenRecord{}, ErrInvalidToken
	}

	return token, nil
}

func (s *Service) lookupToken(ctx context.Context, raw string) (TokenRecord, error) {
	if strings.TrimSpace(raw) == "" {
		return TokenRecord{}, ErrInvalidToken
	}

	token, err := s.store.GetTokenByHash(ctx, HashToken(raw))
	if errors.Is(err, pgx.ErrNoRows) {
		return TokenRecord{}, ErrInvalidToken
	}

	if err != nil {
		return TokenRecord{}, err
	}

	return token, nil
}

func (s *Service) validToken(ctx context.Context, raw, kind string) (TokenRecord, error) {
	token, err := s.lookupToken(ctx, raw)
	if err != nil {
		return TokenRecord{}, err
	}

	if token.Kind != kind {
		return TokenRecord{}, ErrInvalidToken
	}

	if token.UsedAt != nil {
		return TokenRecord{}, ErrInvalidToken
	}

	if time.Now().UTC().After(token.ExpiresAt) {
		return TokenRecord{}, ErrInvalidToken
	}

	return token, nil
}

func (s *Service) sendVerification(ctx context.Context, user UserRecord) error {
	raw, err := s.createToken(ctx, user.ID, tokenKindEmailVerify, 24*time.Hour)
	if err != nil {
		return err
	}

	link := s.link("/verify-email", raw)
	body := "Verify your email address by opening this link:\n\n" + link + "\n\nIf you did not create this account, ignore this email."

	return s.send(ctx, user.Email, "Verify your email address", body)
}

func (s *Service) sendPasswordReset(ctx context.Context, user UserRecord) error {
	raw, err := s.createToken(ctx, user.ID, tokenKindPasswordReset, time.Hour)
	if err != nil {
		return err
	}

	link := s.link("/reset-password", raw)
	body := "Reset your password by opening this link:\n\n" + link + "\n\nIf you did not request this, ignore this email."

	return s.send(ctx, user.Email, "Reset your password", body)
}

func (s *Service) createToken(ctx context.Context, userID uuid.UUID, kind string, ttl time.Duration) (string, error) {
	raw, hash, err := NewOpaqueToken()
	if err != nil {
		return "", err
	}

	tokenID, err := uuid.NewV7()
	if err != nil {
		return "", fmt.Errorf("generate auth token id: %w", err)
	}

	if err := s.store.CreateToken(ctx, CreateTokenParams{
		ID:        tokenID,
		UserID:    userID,
		Kind:      kind,
		TokenHash: hash,
		ExpiresAt: time.Now().UTC().Add(ttl),
	}); err != nil {
		return "", err
	}

	return raw, nil
}

func (s *Service) send(ctx context.Context, to, subject, body string) error {
	if s.email == nil {
		return nil
	}

	return s.email.Send(ctx, to, subject, body)
}

func (s *Service) link(path, token string) string {
	return strings.TrimRight(s.config.PublicBaseURL, "/") + path + "?token=" + url.QueryEscape(token)
}

func (s *Service) requireEmailVerification() bool {
	switch s.config.RequireEmailVerification {
	case "true":
		return true
	case "false":
		return false
	default:
		return s.config.IsProduction()
	}
}

func normalizeEmail(value string) (string, error) {
	value = strings.TrimSpace(value)

	address, err := mail.ParseAddress(value)
	if err != nil || address.Name != "" {
		return "", ErrInvalidEmail
	}

	return strings.ToLower(address.Address), nil
}
