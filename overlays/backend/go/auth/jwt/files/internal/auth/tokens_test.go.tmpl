package auth

import (
	"testing"
	"time"

	"{{.module_path}}/internal/config"
	"github.com/google/uuid"
)

func tokenTestConfig() config.Config {
	return config.Config{
		JWTSecret:      "0123456789abcdef0123456789abcdef",
		JWTIssuer:      "test-issuer",
		JWTAudience:    "test-audience",
		AccessTokenTTL: 15 * time.Minute,
	}
}

func TestTokensAccessRoundTrip(t *testing.T) {
	t.Parallel()

	tokens := NewTokenService(tokenTestConfig())
	account := Account{
		ID:   uuid.MustParse("01934f5a-7d0f-7a61-9e0b-7b2f4b4b6a1e"),
		Role: "admin",
	}

	raw, expiresIn, err := tokens.IssueAccess(account)
	if err != nil {
		t.Fatalf("issue access: %v", err)
	}

	if expiresIn <= 0 {
		t.Fatalf("expires in = %d", expiresIn)
	}

	identity, err := tokens.ParseAccess(raw)
	if err != nil {
		t.Fatalf("parse access: %v", err)
	}

	if identity.UserID != account.ID || identity.Role != "admin" {
		t.Fatalf("identity = %+v", identity)
	}
}

func TestTokensRejectMFAAsAccess(t *testing.T) {
	t.Parallel()

	tokens := NewTokenService(tokenTestConfig())
	userID := uuid.MustParse("01934f5a-7d0f-7a61-9e0b-7b2f4b4b6a1e")

	raw, _, err := tokens.IssueMFA(userID)
	if err != nil {
		t.Fatalf("issue mfa: %v", err)
	}

	if _, err := tokens.ParseAccess(raw); err == nil {
		t.Fatal("MFA token parsed as access token")
	}

	parsed, err := tokens.ParseMFA(raw)
	if err != nil {
		t.Fatalf("parse mfa: %v", err)
	}

	if parsed != userID {
		t.Fatalf("user id = %s", parsed)
	}
}

func TestOpaqueTokenHash(t *testing.T) {
	t.Parallel()

	raw, hash, err := NewOpaqueToken()
	if err != nil {
		t.Fatalf("new token: %v", err)
	}

	if raw == "" || len(hash) != 32 {
		t.Fatalf("raw=%q hash len=%d", raw, len(hash))
	}

	if string(hash) == raw {
		t.Fatal("stored hash equals raw token")
	}
}
