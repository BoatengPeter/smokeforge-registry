// Package auth implements JWT authentication, refresh sessions, and account flows.
package auth

import (
	"context"
	"errors"
	"io"
	"net/http"
	"net/url"

	"{{.module_path}}/internal/config"
	"{{.module_path}}/internal/response"
	"github.com/gin-gonic/gin"
	"github.com/go-playground/validator/v10"
	"github.com/google/uuid"
	openapi_types "github.com/oapi-codegen/runtime/types"
	"go.uber.org/zap"
)

const (
	refreshCookieName = "refresh_token"
	refreshCookiePath = "/api/v1/auth"
	refreshBodyHeader = "X-Refresh-Token-Transport"
	csrfHeader        = "X-Requested-With"
	csrfValue         = "XMLHttpRequest"
)

var (
	errMissingRefreshToken = errors.New("auth: missing refresh token")
	errCSRF                = errors.New("auth: missing csrf header")
)

// ServiceContract is the auth behavior consumed by the HTTP handler.
type ServiceContract interface {
	Register(ctx context.Context, email, password string) (Account, error)
	Login(ctx context.Context, email, password string) (LoginResult, error)
	CompleteMFA(ctx context.Context, challenge, code string) (TokenPair, error)
	Refresh(ctx context.Context, raw string) (TokenPair, error)
	Logout(ctx context.Context, raw string)
	VerifyEmail(ctx context.Context, raw string) error
	ForgotPassword(ctx context.Context, email string)
	ResetPassword(ctx context.Context, raw, password string) error
	Authenticate(ctx context.Context, raw string) (Identity, error)
	GetUser(ctx context.Context, id uuid.UUID) (Account, error)
	GoogleEnabled() bool
	BeginGoogle(w http.ResponseWriter, r *http.Request) error
	LoginWithGoogle(ctx context.Context, w http.ResponseWriter, r *http.Request) (TokenPair, error)
	GoogleSuccessRedirect() string
}

// Handler implements the auth HTTP contract.
type Handler struct {
	service  ServiceContract
	config   config.Config
	logger   *zap.Logger
	validate *validator.Validate
}

// NewHandler constructs the auth handler.
func NewHandler(service ServiceContract, cfg config.Config, logger *zap.Logger) *Handler {
	return &Handler{
		service:  service,
		config:   cfg,
		logger:   logger,
		validate: validator.New(),
	}
}

// RegisterRoutes adds the auth routes to the API.
func (h *Handler) RegisterRoutes(router gin.IRouter) {
	RegisterHandlersWithOptions(router, h, GinServerOptions{
		ErrorHandler: func(c *gin.Context, _ error, statusCode int) {
			response.WriteError(c, response.NewError(statusCode, "invalid_request", "Invalid request", "The request is invalid."))
		},
	})
}

// Register creates an account.
func (h *Handler) Register(c *gin.Context) {
	var request RegisterRequest
	if err := c.ShouldBindJSON(&request); err != nil {
		response.WriteValidationError(c, err)

		return
	}

	if err := h.validate.Struct(request); err != nil {
		response.WriteValidationError(c, err)

		return
	}

	account, err := h.service.Register(c.Request.Context(), string(request.Email), request.Password)
	if err != nil {
		h.writeError(c, err)

		return
	}

	c.JSON(http.StatusCreated, toUser(account))
}

// Login starts a password login.
func (h *Handler) Login(c *gin.Context) {
	var request LoginRequest
	if err := c.ShouldBindJSON(&request); err != nil {
		response.WriteValidationError(c, err)

		return
	}

	if err := h.validate.Struct(request); err != nil {
		response.WriteValidationError(c, err)

		return
	}

	result, err := h.service.Login(c.Request.Context(), string(request.Email), request.Password)
	if err != nil {
		h.writeError(c, err)

		return
	}

	if result.Tokens != nil {
		h.writeTokenResponse(c, http.StatusOK, *result.Tokens)

		return
	}

	c.JSON(http.StatusAccepted, MFAChallenge{
		Challenge: result.MFAChallenge,
		ExpiresIn: result.MFAExpiresIn,
	})
}

// LoginTOTP completes a TOTP login.
func (h *Handler) LoginTOTP(c *gin.Context) {
	var request TOTPVerifyRequest
	if err := c.ShouldBindJSON(&request); err != nil {
		response.WriteValidationError(c, err)

		return
	}

	if err := h.validate.Struct(request); err != nil {
		response.WriteValidationError(c, err)

		return
	}

	tokens, err := h.service.CompleteMFA(c.Request.Context(), request.Challenge, request.Code)
	if err != nil {
		h.writeError(c, err)

		return
	}

	h.writeTokenResponse(c, http.StatusOK, tokens)
}

// Refresh rotates a refresh session.
func (h *Handler) Refresh(c *gin.Context) {
	raw, err := h.refreshToken(c)
	if err != nil {
		h.writeRefreshError(c, err)

		return
	}

	tokens, err := h.service.Refresh(c.Request.Context(), raw)
	if err != nil {
		h.writeError(c, err)

		return
	}

	h.writeTokenResponse(c, http.StatusOK, tokens)
}

// Logout revokes a refresh session.
func (h *Handler) Logout(c *gin.Context) {
	raw, err := h.refreshToken(c)
	if err != nil && !errors.Is(err, errMissingRefreshToken) {
		h.writeRefreshError(c, err)

		return
	}

	h.service.Logout(c.Request.Context(), raw)
	h.clearRefreshCookie(c)
	c.Status(http.StatusNoContent)
}

// StartGoogleOAuth redirects the browser to Google.
func (h *Handler) StartGoogleOAuth(c *gin.Context) {
	if !h.service.GoogleEnabled() {
		response.WriteError(c, response.NewError(http.StatusServiceUnavailable, "oauth_unavailable", "OAuth unavailable", "Google OAuth is not configured."))

		return
	}

	if err := h.service.BeginGoogle(c.Writer, c.Request); err != nil {
		response.WriteError(c, response.NewError(http.StatusBadGateway, "oauth_start_failed", "OAuth start failed", "Google OAuth could not be started."))

		return
	}
}

// GoogleOAuthCallback completes Google OAuth and redirects the browser.
func (h *Handler) GoogleOAuthCallback(c *gin.Context, _ GoogleOAuthCallbackParams) {
	tokens, err := h.service.LoginWithGoogle(c.Request.Context(), c.Writer, c.Request)
	if err != nil {
		h.redirectOAuthError(c)

		return
	}

	h.setRefreshCookie(c, tokens.RefreshToken)
	c.Redirect(http.StatusTemporaryRedirect, h.service.GoogleSuccessRedirect())
}

func (h *Handler) redirectOAuthError(c *gin.Context) {
	successURL, err := url.Parse(h.service.GoogleSuccessRedirect())
	if err != nil {
		response.WriteError(c, response.NewError(http.StatusInternalServerError, "oauth_redirect_failed", "OAuth redirect failed", "The post-login redirect URL is invalid."))

		return
	}

	query := successURL.Query()
	query.Set("error", "oauth_failed")
	successURL.RawQuery = query.Encode()

	c.Redirect(http.StatusTemporaryRedirect, successURL.String())
}

// GetMe returns the current account.
func (h *Handler) GetMe(c *gin.Context) {
	identity, err := h.service.Authenticate(c.Request.Context(), bearerToken(c))
	if err != nil {
		response.WriteUnauthorized(c, "A valid access token is required.")

		return
	}

	account, err := h.service.GetUser(c.Request.Context(), identity.UserID)
	if err != nil {
		response.WriteUnauthorized(c, "The account is unavailable.")

		return
	}

	c.JSON(http.StatusOK, toUser(account))
}

// VerifyEmail consumes an email verification token.
func (h *Handler) VerifyEmail(c *gin.Context) {
	var request VerifyEmailRequest
	if err := c.ShouldBindJSON(&request); err != nil {
		response.WriteValidationError(c, err)

		return
	}

	if err := h.service.VerifyEmail(c.Request.Context(), request.Token); err != nil {
		if errors.Is(err, ErrInvalidToken) {
			response.WriteError(c, response.NewError(http.StatusBadRequest, "invalid_token", "Invalid token", "The verification token is invalid or expired."))

			return
		}

		h.writeError(c, err)

		return
	}

	c.Status(http.StatusNoContent)
}

// ForgotPassword accepts a password reset request.
func (h *Handler) ForgotPassword(c *gin.Context) {
	var request ForgotPasswordRequest
	if err := c.ShouldBindJSON(&request); err != nil {
		response.WriteValidationError(c, err)

		return
	}

	if err := h.validate.Struct(request); err != nil {
		response.WriteValidationError(c, err)

		return
	}

	h.service.ForgotPassword(c.Request.Context(), string(request.Email))
	c.Status(http.StatusAccepted)
}

// ResetPassword consumes a reset token and changes the password.
func (h *Handler) ResetPassword(c *gin.Context) {
	var request ResetPasswordRequest
	if err := c.ShouldBindJSON(&request); err != nil {
		response.WriteValidationError(c, err)

		return
	}

	if err := h.validate.Struct(request); err != nil {
		response.WriteValidationError(c, err)

		return
	}

	if err := h.service.ResetPassword(c.Request.Context(), request.Token, request.Password); err != nil {
		if errors.Is(err, ErrInvalidToken) {
			response.WriteError(c, response.NewError(http.StatusBadRequest, "invalid_token", "Invalid token", "The reset token is invalid or expired."))

			return
		}

		h.writeError(c, err)

		return
	}

	c.Status(http.StatusNoContent)
}

func (h *Handler) writeTokenResponse(c *gin.Context, status int, tokens TokenPair) {
	response := TokenResponse{
		AccessToken: tokens.AccessToken,
		TokenType:   "Bearer",
		ExpiresIn:   tokens.ExpiresIn,
	}

	if h.returnsRefreshInBody(c) {
		response.RefreshToken = &tokens.RefreshToken
	} else {
		h.setRefreshCookie(c, tokens.RefreshToken)
	}

	c.JSON(status, response)
}

func (h *Handler) refreshToken(c *gin.Context) (string, error) {
	var request RefreshRequest

	if c.Request.Body != nil && c.Request.ContentLength != 0 {
		if err := c.ShouldBindJSON(&request); err != nil && !errors.Is(err, io.EOF) {
			return "", err
		}
	}

	if request.RefreshToken != nil && *request.RefreshToken != "" {
		return *request.RefreshToken, nil
	}

	cookie, err := c.Cookie(refreshCookieName)
	if err != nil {
		return "", errMissingRefreshToken
	}

	if c.GetHeader(csrfHeader) != csrfValue {
		return "", errCSRF
	}

	return cookie, nil
}

func (h *Handler) returnsRefreshInBody(c *gin.Context) bool {
	return c.GetHeader(refreshBodyHeader) == "body"
}

func (h *Handler) setRefreshCookie(c *gin.Context, token string) {
	c.SetSameSite(http.SameSiteLaxMode)
	c.SetCookie(
		refreshCookieName,
		token,
		int(h.config.RefreshTokenTTL.Seconds()),
		refreshCookiePath,
		"",
		h.config.CookieSecure,
		true,
	)
}

func (h *Handler) clearRefreshCookie(c *gin.Context) {
	c.SetSameSite(http.SameSiteLaxMode)
	c.SetCookie(
		refreshCookieName,
		"",
		-1,
		refreshCookiePath,
		"",
		h.config.CookieSecure,
		true,
	)
}

func (h *Handler) writeRefreshError(c *gin.Context, err error) {
	switch {
	case errors.Is(err, errCSRF):
		response.WriteForbidden(c, "The CSRF header is required for cookie-based refresh.")
	case errors.Is(err, errMissingRefreshToken):
		response.WriteUnauthorized(c, "A refresh token is required.")
	default:
		response.WriteError(c, response.NewError(http.StatusBadRequest, "invalid_request", "Invalid request", "The refresh request is invalid."))
	}
}

func (h *Handler) writeError(c *gin.Context, err error) {
	switch {
	case errors.Is(err, ErrEmailTaken):
		response.WriteConflict(c, "email_taken", "The email is already registered.")
	case errors.Is(err, ErrInvalidCredentials):
		response.WriteUnauthorized(c, "The email or password is incorrect.")
	case errors.Is(err, ErrEmailNotVerified):
		response.WriteForbidden(c, "The email address must be verified first.")
	case errors.Is(err, ErrInvalidToken):
		response.WriteUnauthorized(c, "The token is invalid or expired.")
	case errors.Is(err, ErrMFAUnavailable):
		response.WriteError(c, response.NewError(http.StatusNotImplemented, "mfa_unavailable", "MFA unavailable", "Second-factor authentication is not configured."))
	case errors.Is(err, ErrInvalidCode):
		response.WriteUnauthorized(c, "The verification code is invalid.")
	case errors.Is(err, ErrWeakPassword), errors.Is(err, ErrInvalidEmail):
		response.WriteError(c, response.NewError(http.StatusUnprocessableEntity, "validation_failed", "Validation failed", "The credentials are invalid."))
	default:
		response.WriteInternalError(c, h.logger, err)
	}
}

func toUser(account Account) User {
	return User{
		Id:            account.ID,
		Email:         openapi_types.Email(account.Email),
		Role:          account.Role,
		EmailVerified: account.EmailVerified,
		CreatedAt:     account.CreatedAt,
	}
}
