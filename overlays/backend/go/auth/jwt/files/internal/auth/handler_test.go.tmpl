func TestHandlerStartGoogleOAuth(t *testing.T) {
	t.Parallel()

	router := newAuthRouter(t, stubAuthService{googleEnabled: true})
	request := httptest.NewRequestWithContext(context.Background(), http.MethodGet, "/api/v1/auth/oauth/google", nil)
	response := httptest.NewRecorder()

	router.ServeHTTP(response, request)

	if response.Code != http.StatusTemporaryRedirect {
		t.Fatalf("status = %d, want 307", response.Code)
	}

	if location := response.Header().Get("Location"); !strings.Contains(location, "accounts.google.com") {
		t.Fatalf("location = %q", location)
	}
}

func TestHandlerGoogleOAuthCallback(t *testing.T) {
	t.Parallel()

	router := newAuthRouter(t, stubAuthService{
		googleEnabled: true,
		googleTokens:  TokenPair{AccessToken: "access", RefreshToken: "refresh", ExpiresIn: 900},
	})
	request := httptest.NewRequestWithContext(
		context.Background(),
		http.MethodGet,
		"/api/v1/auth/oauth/google/callback?code=code&state=state",
		nil,
	)
	response := httptest.NewRecorder()

	router.ServeHTTP(response, request)

	if response.Code != http.StatusTemporaryRedirect {
		t.Fatalf("status = %d, want 307", response.Code)
	}

	if cookie := response.Header().Get("Set-Cookie"); !strings.Contains(cookie, refreshCookieName) {
		t.Fatalf("set-cookie = %q", cookie)
	}

	if location := response.Header().Get("Location"); location != "http://localhost:8080" {
		t.Fatalf("location = %q", location)
	}
}
