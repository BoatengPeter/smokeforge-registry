// Package main creates optional development users.
package main

import (
	"context"
	"fmt"
	"os"

	"{{.module_path}}/internal/config"
	"{{.module_path}}/internal/database"
	"{{.module_path}}/internal/database/seed"
)

func main() {
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

func run() error {
	cfg, err := config.Load()
	if err != nil {
		return fmt.Errorf("load config: %w", err)
	}

	db, err := database.New(context.Background(), cfg)
	if err != nil {
		return fmt.Errorf("connect database: %w", err)
	}
	defer db.Close()

	if err := seed.Run(context.Background(), db.Pool(), cfg); err != nil {
		return err
	}

	if _, err := fmt.Fprintln(os.Stdout, "seed user created"); err != nil {
		return fmt.Errorf("write output: %w", err)
	}

	return nil
}
