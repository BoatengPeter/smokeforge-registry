use std::time::Duration;

use async_trait::async_trait;
use sqlx::{PgPool, postgres::PgPoolOptions};

use crate::{config::Config, error::AppError, state::Readiness};

/// Shared PostgreSQL database handle.
#[derive(Clone)]
pub struct Database {
    pool: PgPool,
}

impl Database {
    /// Opens a bounded pool and verifies connectivity.
    pub async fn connect(config: &Config) -> Result<Self, AppError> {
        let pool = PgPoolOptions::new()
            .max_connections(config.database_max_connections)
            .acquire_timeout(Duration::from_secs(config.database_connect_timeout_seconds))
            .connect(&config.database_url)
            .await
            .map_err(|error| {
                tracing::error!(error = %error, "database connection failed");
                AppError::internal("database is unavailable")
            })?;

        Ok(Self { pool })
    }

    /// Returns the underlying pool.
    pub fn pool(&self) -> &PgPool {
        &self.pool
    }
}

#[async_trait]
impl Readiness for Database {
    async fn ready(&self) -> Result<(), AppError> {
        sqlx::query("SELECT 1")
            .execute(&self.pool)
            .await
            .map_err(|error| {
                tracing::warn!(error = %error, "database readiness failed");
                AppError::new(
                    axum::http::StatusCode::SERVICE_UNAVAILABLE,
                    "not_ready",
                    "Not ready",
                    "A required dependency is unavailable.",
                )
            })?;

        Ok(())
    }
}
