use std::sync::Arc;

use {{.crate_name}}::{
    config::Config,
    queue::{self, rabbitmq::Rabbit},
    telemetry,
};
// smokeforge:anchor worker-search-import

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    let config = Config::load()?;
    telemetry::init(&config)?;

    let rabbit = Rabbit::connect(&config).await?;
    // smokeforge:anchor worker-codec
    let mut registry = queue::Registry::new();
    registry.register(
        "system.heartbeat",
        Arc::new(queue::rabbitmq::HeartbeatHandler),
    );
    // smokeforge:anchor worker-search

    rabbit
        .run(Arc::new(registry), config.rabbitmq_prefetch)
        .await?;

    Ok(())
}
