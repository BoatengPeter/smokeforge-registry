# --- Core -------------------------------------------------------------------
# Public application URL used for metadataBase, OpenGraph, sitemap, and robots.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional external API origin for standalone frontends. Leave unset to use the
# app's same-origin /api routes.
# NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Database (database:postgres overlay) -----------------------------------
# Local development:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# Inside Docker Compose, use the compose service host instead:
# DATABASE_URL=postgres://postgres:postgres@db:5432/app

# --- Better Auth (auth:session overlay) -------------------------------------
# Generate locally: openssl rand -base64 32
# BETTER_AUTH_SECRET=replace-with-a-generated-secret
# BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated origins if the app is served from another origin:
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# --- PostHog (analytics:posthog overlay) ------------------------------------
# Client keys are public by design. Analytics stays disabled without a key and
# must not capture until the user opts in.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Runtime ----------------------------------------------------------------
# Optional pino level: trace, debug, info, warn, error, fatal.
# LOG_LEVEL=debug
# Docker sets PORT=3000 internally. Override only if your platform requires it.
# PORT=3000
