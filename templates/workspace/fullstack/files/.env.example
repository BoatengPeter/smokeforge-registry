# --- Fullstack workspace ----------------------------------------------------
# API origin reached by the Next.js BFF. Browser clients use same-origin
# /api/auth/* routes and never call the API directly.
API_URL=http://localhost:8080

# Public web origin used for metadata and same-origin checks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Desktop Electron main-process API origin.
# DESKTOP_API_URL=http://localhost:8080
