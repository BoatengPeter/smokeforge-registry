.PHONY: help install api-dev web-dev api-test web-test test ci docker-up docker-down clean
# smokeforge:anchor desktop-phony
# smokeforge:anchor mobile-phony

help:
	@echo "make install    Install API and web dependencies"
	@echo "make api-dev    Run the API"
	@echo "make web-dev    Run the Next.js app"
	@echo "make test       Run API and web tests"
	@echo "make ci         Run API and web CI checks"
	@echo "make docker-up  Build and start the full stack"
	@echo "make docker-down Stop the full stack"
	# smokeforge:anchor desktop-help
	# smokeforge:anchor mobile-help

# smokeforge:anchor desktop-targets

# smokeforge:anchor mobile-targets

install:
	$(MAKE) -C apps/api install
	$(MAKE) -C apps/web install
	# smokeforge:anchor desktop-install
	# smokeforge:anchor mobile-install

api-dev:
	$(MAKE) -C apps/api run

web-dev:
	$(MAKE) -C apps/web dev

api-test:
	$(MAKE) -C apps/api test

web-test:
	$(MAKE) -C apps/web test

test: api-test web-test
	# smokeforge:anchor desktop-test
	# smokeforge:anchor mobile-test

ci:
	$(MAKE) -C apps/api ci
	$(MAKE) -C apps/web ci
	# smokeforge:anchor desktop-ci
	# smokeforge:anchor mobile-ci

docker-up:
	docker compose up --build -d

docker-down:
	docker compose down

clean:
	$(MAKE) -C apps/api clean
	$(MAKE) -C apps/web clean
	# smokeforge:anchor desktop-clean
	# smokeforge:anchor mobile-clean
