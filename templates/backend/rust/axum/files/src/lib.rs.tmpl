/// Ping response.
#[derive(Debug, Serialize, utoipa::ToSchema)]
pub struct PingResponse {
    pub message: String,
}

/// OpenAPI document served by the application.
#[derive(OpenApi)]
#[openapi(
    info(title = "API", version = "0.1.0"),
    paths(
        crate::health::routes::health_check,
        crate::health::routes::ready_check,
        ping
    ),
    components(schemas(PingResponse, health::routes::HealthResponse, response::ProblemDetails))
)]
pub struct ApiDoc;

/// Builds the merged OpenAPI document.
#[allow(unused_mut)] // feature overlays merge additional documents
pub fn openapi() -> utoipa::openapi::OpenApi {
    let mut document = ApiDoc::openapi();
    // smokeforge:anchor openapi-merge
    document
}

/// Builds the HTTP router with the base middleware stack.
pub fn app(config: &Config, state: AppState) -> Result<Router, Box<dyn std::error::Error>> {
    let request_id_header = header::HeaderName::from_static("x-request-id");
    let origins = config.cors_origins();
    let cors = if origins.is_empty() {
        CorsLayer::new()
    } else {
        let values = origins
            .iter()
            .map(|origin| HeaderValue::from_str(origin))
            .collect::<Result<Vec<_>, _>>()?;

        CorsLayer::new()
            .allow_origin(AllowOrigin::list(values))
            .allow_methods([
                Method::GET,
                Method::POST,
                Method::PUT,
                Method::PATCH,
                Method::DELETE,
                Method::OPTIONS,
            ])
            .allow_headers([header::AUTHORIZATION, header::CONTENT_TYPE])
    };

    let governor = GovernorConfigBuilder::default()
        .per_second(config.rate_limit_per_second)
        .burst_size(config.rate_limit_burst)
        .finish()
        .ok_or("invalid rate limit configuration")?;

    let router = Router::new()
        .route("/healthz", get(health_check))
        .route("/readyz", get(ready_check))
        .route("/api/v1/ping", get(ping))
        .merge(SwaggerUi::new("/docs").url("/openapi.json", openapi()))
        .layer(GovernorLayer::new(Arc::new(governor)))
        .layer(TimeoutLayer::with_status_code(
            StatusCode::REQUEST_TIMEOUT,
            Duration::from_secs(config.request_timeout_seconds),
        ))
        .layer(DefaultBodyLimit::max(config.max_body_bytes))
        .layer(CompressionLayer::new())
        .layer(cors)
        .layer(SetResponseHeaderLayer::overriding(
            header::X_CONTENT_TYPE_OPTIONS,
            HeaderValue::from_static("nosniff"),
        ))
        .layer(SetResponseHeaderLayer::overriding(
            header::X_FRAME_OPTIONS,
            HeaderValue::from_static("DENY"),
        ))
        .layer(PropagateRequestIdLayer::new(request_id_header.clone()))
        .layer(axum::middleware::from_fn(response::finalize_problem))
        .layer(SetRequestIdLayer::new(request_id_header, MakeRequestUuid))
        .layer(TraceLayer::new_for_http())
        .layer(CatchPanicLayer::new())
        .with_state(state);

    Ok(router)
}

#[utoipa::path(get, path = "/api/v1/ping", responses((status = 200, body = PingResponse)))]
async fn ping(State(_state): State<AppState>) -> Result<Json<PingResponse>, AppError> {
    Ok(Json(PingResponse {
        message: "pong".to_owned(),
    }))
}

/// Returns the HTTP status used when no route matches.
pub const NOT_FOUND: StatusCode = StatusCode::NOT_FOUND;
