#[tokio::test]
async fn readiness_errors_include_request_context() {
    let state = AppState::new("test-service").with_readiness(Arc::new(FailingReadiness));
    let response = common::test_app_with_state(state)
        .oneshot(
            Request::get("/readyz")
                .header("x-forwarded-for", "127.0.0.1")
                .header("x-request-id", "readiness-test-id")
                .body(Body::empty())
                .unwrap(),
        )
        .await
        .unwrap();

    assert_eq!(response.status(), StatusCode::SERVICE_UNAVAILABLE);

    let body = response.into_body().collect().await.unwrap().to_bytes();
    let problem: Value = serde_json::from_slice(&body).unwrap();

    assert_eq!(problem["instance"], "/readyz");
    assert_eq!(problem["request_id"], "readiness-test-id");
    assert_eq!(problem["code"], "not_ready");
}

#[tokio::test]
async fn security_headers_are_present() {
    let response = common::test_app()
        .oneshot(
            Request::get("/healthz")
                .header("x-forwarded-for", "127.0.0.1")
                .body(Body::empty())
                .unwrap(),
        )
        .await
        .unwrap();

    let headers = response.headers();
    assert_eq!(
        headers
            .get(header::X_CONTENT_TYPE_OPTIONS)
            .and_then(|value| value.to_str().ok()),
        Some("nosniff")
    );
    assert_eq!(
        headers
            .get(header::X_FRAME_OPTIONS)
            .and_then(|value| value.to_str().ok()),
        Some("DENY")
    );
    assert_eq!(
        headers
            .get("referrer-policy")
            .and_then(|value| value.to_str().ok()),
        Some("no-referrer")
    );
    assert!(headers.get(header::STRICT_TRANSPORT_SECURITY).is_none());
}
