mod common;

use std::sync::Arc;

use async_trait::async_trait;
use axum::{
    body::Body,
    http::{Request, StatusCode, header},
};
use http_body_util::BodyExt;
use serde_json::Value;
use tower::ServiceExt;
#[rustfmt::skip]
use {{.crate_name}}::{
    error::AppError,
    state::{AppState, Readiness},
};

struct FailingReadiness;

#[async_trait]
impl Readiness for FailingReadiness {
    async fn ready(&self) -> Result<(), AppError> {
        Err(AppError::new(
            StatusCode::SERVICE_UNAVAILABLE,
            "not_ready",
            "Not ready",
            "The dependency is unavailable.",
        ))
    }
}

#[tokio::test]
async fn health_is_available() {
    let response = common::test_app()
        .oneshot(
            Request::get("/healthz")
                .header("x-forwarded-for", "127.0.0.1")
                .body(Body::empty())
                .unwrap(),
        )
        .await
        .unwrap();

    assert_eq!(response.status(), StatusCode::OK);
    assert!(
        response
            .headers()
            .contains_key(header::HeaderName::from_static("x-request-id"))
    );
}

