use std::net::SocketAddr;

use axum::{Extension, extract::ConnectInfo};
use {{.crate_name}}::{app, config::Config, state::AppState};

pub fn test_app() -> axum::Router {
    test_app_with_state(AppState::new("test-service"))
}

pub fn test_app_with_state(state: AppState) -> axum::Router {
    app(&Config::default(), state)
        .expect("build test router")
        .layer(Extension(ConnectInfo(SocketAddr::from((
            [127, 0, 0, 1],
            12345,
        )))))
}
