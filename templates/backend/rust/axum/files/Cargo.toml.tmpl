[package]
name = "{{.crate_name}}"
version = "0.1.0"
edition = "2024"
rust-version = "1.96"
publish = false
default-run = "{{.crate_name}}"

[dependencies]
async-trait = "0.1.92"
axum = "0.8.9"
dotenvy = "0.15.7"
figment = { version = "0.10.19", features = ["env", "toml"] }
hmac = "0.13.0"
serde = { version = "1.0.229", features = ["derive"] }
serde_json = "1.0.154"
reqwest = { version = "0.13.5", features = ["json"] }
sha2 = "0.11.1"
thiserror = "2.0.21"
tokio = { version = "1.54.1", features = ["macros", "rt-multi-thread", "signal", "net", "time"] }
tower = { version = "0.5.3", features = ["util"] }
tower-http = { version = "0.7.1", features = [
  "catch-panic",
  "compression-gzip",
  "cors",
  "limit",
  "request-id",
  "set-header",
  "timeout",
  "trace",
] }
tower_governor = "0.8.0"
tracing = "0.1.44"
tracing-subscriber = { version = "0.3.23", features = ["env-filter", "json"] }
utoipa = { version = "6.0.0", features = ["time", "uuid"] }
utoipa-swagger-ui = { version = "10.0.2", features = ["axum"] }
uuid = { version = "1.29.2", features = ["serde", "v4", "v7"] }

[dev-dependencies]
http-body-util = "0.1.3"
tower = { version = "0.5.3", features = ["util"] }
