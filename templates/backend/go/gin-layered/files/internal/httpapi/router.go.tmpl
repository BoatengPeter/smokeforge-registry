package httpapi

import (
	"net/http"

	"{{.module_path}}/internal/config"
	"{{.module_path}}/internal/response"
	"{{.module_path}}/internal/swagger"
	"github.com/gin-gonic/gin"
	"go.uber.org/zap"
)

// Registrar adds a feature's routes and OpenAPI document to the API.
type Registrar interface {
	RegisterRoutes(router gin.IRouter)
}

// DocumentedRegistrar contributes an OpenAPI document to Swagger UI.
type DocumentedRegistrar interface {
	Registrar
	OpenAPISpec() []byte
}

type options struct {
	pinger     Pinger
	readiness  Readiness
	registrars []Registrar
}

// Option customizes the HTTP server.
type Option func(*options)

// WithPinger configures the application service used by the ping endpoint.
func WithPinger(pinger Pinger) Option {
	return func(options *options) {
		options.pinger = pinger
	}
}

// WithReadiness configures the readiness dependency.
func WithReadiness(readiness Readiness) Option {
	return func(options *options) {
		options.readiness = readiness
	}
}

// WithRegistrar adds a feature route registrar.
func WithRegistrar(registrar Registrar) Option {
	return func(options *options) {
		options.registrars = append(options.registrars, registrar)
	}
}

// New builds the Gin engine with middleware, generated routes, feature routes,
// and Swagger UI.
func New(cfg config.Config, logger *zap.Logger, opts ...Option) (*gin.Engine, error) {
	gin.SetMode(cfg.HTTPMode())

	serverOptions := options{}
	for _, option := range opts {
		option(&serverOptions)
	}

	engine := gin.New()
	if err := engine.SetTrustedProxies(cfg.TrustedProxies); err != nil {
		return nil, err
	}

	engine.HandleMethodNotAllowed = true
	engine.Use(
		RequestIDMiddleware(),
		RequestLogger(logger),
		Recovery(logger),
		SecurityHeaders(cfg.IsProduction()),
		CORS(CORSOptions{
			AllowedOrigins:   cfg.CORSAllowedOrigins,
			AllowedMethods:   cfg.CORSAllowedMethods,
			AllowedHeaders:   cfg.CORSAllowedHeaders,
			ExposedHeaders:   cfg.CORSExposedHeaders,
			AllowCredentials: cfg.CORSAllowCredentials,
			MaxAge:           cfg.CORSMaxAge,
		}),
		BodyLimit(cfg.MaxBodyBytes),
		RateLimit(cfg.RateLimitRPS, cfg.RateLimitBurst),
		Timeout(cfg.RequestTimeout),
	)

	requestHandler := newHandler(
		serverOptions.pinger,
		serverOptions.readiness,
		logger,
		cfg.ServiceName,
	)

	RegisterHandlersWithOptions(engine, requestHandler, GinServerOptions{
		ErrorHandler: func(c *gin.Context, _ error, statusCode int) {
			response.WriteError(c, response.NewError(statusCode, "invalid_request", "Invalid request", "The request is invalid."))
		},
	})

	for _, registrar := range serverOptions.registrars {
		registrar.RegisterRoutes(engine)
	}

	if cfg.DocsEnabled() {
		documents := make([][]byte, 0, len(serverOptions.registrars))
		for _, registrar := range serverOptions.registrars {
			documented, ok := registrar.(DocumentedRegistrar)
			if !ok {
				continue
			}

			documents = append(documents, documented.OpenAPISpec())
		}

		if err := swagger.Register(engine, cfg.APITitle, documents); err != nil {
			return nil, err
		}
	}

	engine.NoRoute(func(c *gin.Context) {
		response.WriteNotFound(c, "The requested resource does not exist.")
	})
	engine.NoMethod(func(c *gin.Context) {
		response.WriteError(c, response.NewError(http.StatusMethodNotAllowed, "method_not_allowed", "Method not allowed", "The method is not supported for this resource."))
	})

	return engine, nil
}
