[workspace]
resolver = "2"
members = ["crates/core", "crates/api-client", "crates/storage", "crates/ui", "crates/app", "crates/desktop"]
default-members = ["crates/desktop"]

[workspace.package]
version = "0.1.0"
edition = "2024"
rust-version = "1.96"
license = "MIT"

[workspace.dependencies]
anyhow = "1.0.100"
chrono = { version = "0.4.42", features = ["serde"] }
directories = "6.0.0"
garde = { version = "0.23.0", features = ["derive"] }
gpui-kit = { version = "=0.10.0" }
image = { version = "0.25.10", default-features = false, features = ["png"] }
keyring = { version = "4.2.0", features = ["v1"] }
rusqlite = { version = "0.40.2", features = ["bundled", "uuid", "serde_json"] }
r2d2 = "0.8.10"
r2d2_sqlite = "0.35.0"
refinery = { version = "0.10.0", features = ["rusqlite"] }
reqwest = { version = "0.13.1", default-features = false, features = ["json", "rustls"] }
rust-i18n = "4.2.4"
serde = { version = "1.0.229", features = ["derive"] }
serde_json = "1.0.154"
thiserror = "2.0.21"
tokio = { version = "1.54.0", features = ["rt-multi-thread", "time"] }
tracing = "0.1.44"
tracing-appender = "0.2.5"
tracing-subscriber = { version = "0.3.23", features = ["env-filter", "json"] }
url = "2.5.8"
uuid = { version = "1.29.2", features = ["serde", "v4"] }

[workspace.lints.rust]
unsafe_code = "forbid"

[workspace.lints.clippy]
all = { level = "warn", priority = -1 }
pedantic = { level = "warn", priority = -1 }

[profile.release]
lto = "thin"
codegen-units = 1
strip = true
