.PHONY: help dev dev-tools watch-check watch-test require-cargo-watch doctor install build check test lint fmt run desktop-entry package docker-build docker-run clean

help:
	@echo "make doctor    Check Linux native build dependencies"
	@echo "make dev       Run the GPUI app and rebuild + restart it on every save (cargo-watch)"
	@echo "make run       Run the GPUI desktop app once"
	@echo "make watch-check Re-run cargo check on every save"
	@echo "make watch-test  Re-run workspace tests on every save"
	@echo "make dev-tools Install the pinned cargo-watch used by the watch targets"
	@echo "make desktop-entry Install a local launcher so the app icon appears in the desktop shell"
	@echo "make check     Cargo check the workspace"
	@echo "make test      Run workspace tests"
	@echo "make lint      Run clippy with warnings denied"
	@echo "make fmt       Format the workspace"
	@echo "make package   Build a native package with cargo-packager"
	@echo "make docker-build Build the GPUI Docker image"
	@echo "make docker-run   Run the GPUI Docker image with X11"

doctor:
	@command -v pkg-config >/dev/null || { echo "missing pkg-config"; exit 1; }
	@for package in xkbcommon xkbcommon-x11 fontconfig; do pkg-config --exists "$$package" || { echo "missing native package: $$package (install the -dev package)"; exit 1; }; done
	@echo "native build dependencies look good"

install:
	cargo fetch

run: desktop-entry
	cargo run -p {{.crate_name}}

# Watch mode. Only crate sources (including locales and migrations), the
# workspace manifest, and assets trigger a rebuild. target/, Cargo.lock, and
# the app's data/config/log directories are not watched, so a running app never
# retriggers itself. cargo-watch stops the old process before starting the new
# one; settings, SQLite data, and saved layout survive the restart.
WATCH_PATHS := -w crates -w Cargo.toml -w assets
CARGO_WATCH_VERSION := 8.5.3

dev: require-cargo-watch desktop-entry
	cargo watch -c -q $(WATCH_PATHS) -x 'run -p {{.crate_name}}'

watch-check: require-cargo-watch
	cargo watch -c -q $(WATCH_PATHS) -x 'check --workspace --all-targets'

watch-test: require-cargo-watch
	cargo watch -c -q $(WATCH_PATHS) -x 'test --workspace'

dev-tools:
	cargo install cargo-watch --version $(CARGO_WATCH_VERSION) --locked

require-cargo-watch:
	@cargo watch --version >/dev/null 2>&1 || { echo "cargo-watch is not installed. Run: make dev-tools"; exit 1; }

desktop-entry:
	@sh scripts/install-dev-desktop.sh

build:
	cargo build --workspace

check:
	cargo check --workspace

test:
	cargo test --workspace

lint:
	cargo clippy --workspace --all-targets -- -D warnings

fmt:
	cargo fmt --all

package:
	cargo packager --release

docker-build:
	docker build -t {{.crate_name}} .

docker-run:
	docker run --rm -it -e DISPLAY="$$DISPLAY" -v /tmp/.X11-unix:/tmp/.X11-unix:rw --device /dev/dri --group-add video {{.crate_name}}

clean:
	cargo clean
