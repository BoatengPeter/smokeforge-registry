.PHONY: help doctor install build check test lint fmt run package clean

help:
	@echo "make doctor    Check Linux native build dependencies"
	@echo "make run       Run the GPUI desktop app"
	@echo "make check     Cargo check the workspace"
	@echo "make test      Run workspace tests"
	@echo "make lint      Run clippy with warnings denied"
	@echo "make fmt       Format the workspace"
	@echo "make package   Build a native package with cargo-packager"

doctor:
	@command -v pkg-config >/dev/null || { echo "missing pkg-config"; exit 1; }
	@for package in xkbcommon xkbcommon-x11 fontconfig; do pkg-config --exists "$$package" || { echo "missing native package: $$package (install the -dev package)"; exit 1; }; done
	@echo "native build dependencies look good"

install:
	cargo fetch

run:
	cargo run -p {{.crate_name}}

build:
	cargo build --workspace

check:
	cargo check --workspace

test:
	cargo test --workspace

lint:
	cargo clippy --workspace --all-targets -- -D warnings

fmt:
	cargo fmt --all

package:
	cargo packager --release

clean:
	cargo clean
