#![cfg_attr(not(debug_assertions), windows_subsystem = "windows")]
#![allow(
    clippy::wildcard_imports,
    reason = "GPUI Kit exports the framework prelude."
)]

use gpui_kit::component::TitleBar;
use gpui_kit::*;

fn main() {
    gpui_kit::application()
        .with_assets(gpui_kit::assets::Assets)
        .run(|cx| {
            gpui_kit::init(cx);
            cx.bind_keys([
                KeyBinding::new("cmd-1", {{.crate_name}}_app::ShowDashboard, None),
                KeyBinding::new("cmd-2", {{.crate_name}}_app::ShowLibrary, None),
                KeyBinding::new("cmd-3", {{.crate_name}}_app::ShowActivity, None),
                KeyBinding::new("cmd-4", {{.crate_name}}_app::ShowSettings, None),
                KeyBinding::new("cmd-5", {{.crate_name}}_app::ShowAccount, None),
                KeyBinding::new("cmd-6", {{.crate_name}}_app::ShowAbout, None),
                KeyBinding::new("cmd-k", {{.crate_name}}_app::ToggleCommand, None),
                KeyBinding::new("cmd-shift-l", {{.crate_name}}_app::ToggleTheme, None),
            ]);
            let options = WindowOptions {
                window_bounds: Some(WindowBounds::Windowed(Bounds::centered(
                    None,
                    size(px(1180.), px(760.)),
                    cx,
                ))),
                ..TitleBar::window_options()
            };
            gpui_kit::open_window(options, cx, |window, cx| {
                cx.new(|cx| {{.crate_name}}_app::AppView::new(window, cx))
            })
            .expect("failed to open the main window");
        });
}
