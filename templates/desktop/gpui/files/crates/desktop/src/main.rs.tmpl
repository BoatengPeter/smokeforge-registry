#![cfg_attr(not(debug_assertions), windows_subsystem = "windows")]
#![allow(
    clippy::wildcard_imports,
    reason = "GPUI Kit exports the framework prelude."
)]

use std::io::{Read, Write};
use std::net::{TcpListener, TcpStream};
use std::sync::Arc;
use std::sync::atomic::{AtomicBool, Ordering};

use gpui_kit::component::TitleBar;
use gpui_kit::*;

fn main() {
    install_panic_hook();
    if forward_to_running_instance() {
        return;
    }
    let (focus, _listener) = start_instance_listener();

    gpui_kit::application()
        .with_assets(gpui_kit::assets::Assets)
        .run(move |cx| {
            gpui_kit::init(cx);
            cx.bind_keys([
                KeyBinding::new("cmd-1", {{.crate_name}}_app::ShowDashboard, None),
                KeyBinding::new("cmd-2", {{.crate_name}}_app::ShowLibrary, None),
                KeyBinding::new("cmd-3", {{.crate_name}}_app::ShowActivity, None),
                KeyBinding::new("cmd-4", {{.crate_name}}_app::ShowSettings, None),
                KeyBinding::new("cmd-5", {{.crate_name}}_app::ShowAccount, None),
                KeyBinding::new("cmd-6", {{.crate_name}}_app::ShowAbout, None),
                KeyBinding::new("cmd-k", {{.crate_name}}_app::ToggleCommand, None),
                KeyBinding::new("cmd-shift-l", {{.crate_name}}_app::ToggleTheme, None),
            ]);
            let icon = image::load_from_memory(include_bytes!("../../../assets/icon.png"))
                .expect("embedded application icon")
                .into_rgba8();
            let options = WindowOptions {
                window_bounds: Some(WindowBounds::Windowed(Bounds::centered(
                    None,
                    size(px(1180.), px(760.)),
                    cx,
                ))),
                app_id: Some("{{.bundle_id}}".to_owned()),
                icon: Some(Arc::new(icon)),
                ..TitleBar::window_options()
            };
            gpui_kit::open_window(options, cx, |window, cx| {
                cx.new(|cx| {{.crate_name}}_app::AppView::new(window, cx, focus.clone()))
            })
            .expect("failed to open the main window");
        });
}

fn instance_path() -> std::path::PathBuf {
    std::env::temp_dir().join("{{.crate_name}}-instance.port")
}

fn forward_to_running_instance() -> bool {
    let Ok(port) = std::fs::read_to_string(instance_path()) else {
        return false;
    };
    let Ok(mut stream) = TcpStream::connect(("127.0.0.1", port.trim().parse::<u16>().unwrap_or(0)))
    else {
        return false;
    };
    let args = std::env::args().skip(1).collect::<Vec<_>>().join("\u{0}");
    stream.write_all(args.as_bytes()).is_ok()
}

fn start_instance_listener() -> (Arc<AtomicBool>, Option<std::thread::JoinHandle<()>>) {
    let focus = Arc::new(AtomicBool::new(false));
    let Ok(listener) = TcpListener::bind(("127.0.0.1", 0)) else {
        return (focus, None);
    };
    let Ok(address) = listener.local_addr() else {
        return (focus, None);
    };
    let _ = std::fs::write(instance_path(), address.port().to_string());
    let signal = Arc::clone(&focus);
    let handle = std::thread::spawn(move || {
        for mut stream in listener.incoming().flatten() {
            let mut args = String::new();
            let _ = stream.read_to_string(&mut args);
            signal.store(true, Ordering::Relaxed);
        }
    });

    (focus, Some(handle))
}

fn install_panic_hook() {
    let path = std::env::temp_dir().join("{{.crate_name}}-panic.log");
    let default_hook = std::panic::take_hook();
    std::panic::set_hook(Box::new(move |info| {
        let _ = std::fs::write(&path, format!("{info}\n"));
        // Keep the standard stderr report so panics show up in `make dev`.
        default_hook(info);
    }));
}
