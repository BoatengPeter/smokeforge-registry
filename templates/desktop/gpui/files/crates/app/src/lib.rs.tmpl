#[derive(Debug, Clone)]
pub enum Action {
    SetLanguage(String),
}

gpui_kit::actions!(
    smokeforge,
    [
        ShowDashboard,
        ShowLibrary,
        ShowActivity,
        ShowSettings,
        ShowAccount,
        ShowAbout,
        ToggleCommand,
        ToggleTheme
    ]
);

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Pane {
    Dashboard,
    Library,
    Activity,
    Settings,
    Account,
    About,
}

impl Pane {
    fn available(api_mode: bool) -> Vec<Self> {
        let mut panes = vec![
            Self::Dashboard,
            Self::Library,
            Self::Activity,
            Self::Settings,
        ];
        if api_mode {
            panes.push(Self::Account);
        }
        panes.push(Self::About);
        panes
    }

    const fn title_key(self) -> &'static str {
        match self {
            Self::Dashboard => "nav.dashboard",
            Self::Library => "nav.library",
            Self::Activity => "nav.activity",
            Self::Settings => "nav.settings",
            Self::Account => "nav.account",
            Self::About => "nav.about",
        }
    }

    fn label(self) -> String {
        t(self.title_key())
    }
}

pub struct AppView {
    active: Pane,
    logo: Arc<Image>,
    show_command: bool,
    command_state: Entity<CommandState>,
    paths: {{.crate_name}}_storage::Paths,
    settings: {{.crate_name}}_storage::Settings,
    settings_store: {{.crate_name}}_storage::SettingsStore,
    _logging_guard: logging::LoggingGuard,
    tokens: credentials::TokenStore,
    api_mode: bool,
    api_base: String,
    email_input: Entity<InputState>,
    password_input: Entity<InputState>,
    auth_status: String,
    access_token: Option<String>,
    auth_task: Option<Task<()>>,
    sync_task: Option<Task<()>>,
    sync_status: String,
    focus_requested: std::sync::Arc<std::sync::atomic::AtomicBool>,
    applied_theme: String,
    database: Option<{{.crate_name}}_storage::Database>,
    /// Why the database could not be opened, shown as a status page.
    database_error: Option<String>,
    title_input: Entity<InputState>,
    tags_input: Entity<InputState>,
}

impl AppView {
    pub fn new(
        window: &mut Window,
        cx: &mut Context<Self>,
        focus_requested: std::sync::Arc<std::sync::atomic::AtomicBool>,
    ) -> Self {
        let paths = {{.crate_name}}_storage::Paths::discover("Smokeforge").unwrap_or_else(|_| {
            {{.crate_name}}_storage::Paths {
                data: std::env::temp_dir().join("smokeforge"),
                config: std::env::temp_dir().join("smokeforge"),
                logs: std::env::temp_dir().join("smokeforge-logs"),
            }
        });
        let settings_store = {{.crate_name}}_storage::SettingsStore::new(&paths.config);
        let settings = settings_store.load().unwrap_or_default();
        let logging_guard = logging::init(&paths.logs, &settings.log_level);
        let (database, database_error) = open_database(&paths);
        let title_input = cx.new(|cx| InputState::new(window, cx).placeholder("Title"));
        let tags_input =
            cx.new(|cx| InputState::new(window, cx).placeholder("tags, comma separated"));
        let api_mode = std::env::var("SMOKEFORGE_API_MODE")
            .is_ok_and(|value| matches!(value.as_str(), "api" | "1" | "true"));
        let api_base = std::env::var("SMOKEFORGE_API_URL")
            .unwrap_or_else(|_| "http://localhost:8080".to_owned());
        let email_input = cx.new(|cx| InputState::new(window, cx).placeholder("Email"));
        let password_input = cx.new(|cx| {
            InputState::new(window, cx)
                .placeholder("Password")
                .masked(true)
        });
        Self {
            active: Pane::Dashboard,
            logo: Arc::new(Image::from_bytes(
                ImageFormat::Png,
                include_bytes!("../../../assets/logo.png").to_vec(),
            )),
            show_command: false,
            command_state: cx.new(|cx| CommandState::new(window, cx)),
            paths,
            settings,
            settings_store,
            _logging_guard: logging_guard,
            database,
            database_error,
            title_input,
            tags_input,
            tokens: credentials::TokenStore::new("{{.bundle_id}}", "auth"),
            api_mode,
            api_base,
            email_input,
            password_input,
            auth_status: String::new(),
            access_token: None,
            auth_task: None,
            sync_task: None,
            sync_status: String::new(),
            focus_requested,
            applied_theme: String::new(),
        }
    }
}

impl AppView {
    pub fn dispatch(&mut self, action: Action) {
        match action {
            Action::SetLanguage(language) => {
                language.clone_into(&mut self.settings.language);
                language.clone_into(&mut self.settings.locale);
                rust_i18n::set_locale(&language);
                let _ = self.settings_store.save(&self.settings);
            }
        }
    }

    /// Reopens the database after a failure.
    fn reopen_database(&mut self, cx: &mut Context<Self>) {
        let (database, error) = open_database(&self.paths);
        self.database = database;
        self.database_error = error;
        cx.notify();
    }

    fn pane_body(&mut self, cx: &mut Context<Self>) -> AnyElement {
        let needs_records = matches!(
            self.active,
            Pane::Dashboard | Pane::Library | Pane::Activity
        );
        if needs_records && let Some(error) = self.database_error.clone() {
            return self.database_error_page(error, cx);
        }
        match self.active {
            Pane::Dashboard => self.dashboard_body(cx),
            Pane::Activity => self.activity_body(cx),
            Pane::About => self.about_body(cx),
            Pane::Settings => self.settings_body(cx),
            Pane::Account => self.account_body(cx),
            Pane::Library => self.library_body(cx).into_any_element(),
        }
    }
}

/// Opens and seeds the local database, or returns why it failed.
fn open_database(
    paths: &{{.crate_name}}_storage::Paths,
) -> (Option<{{.crate_name}}_storage::Database>, Option<String>) {
    match {{.crate_name}}_storage::Database::open(&paths.data.join("local.sqlite")) {
        Ok(database) => {
            let _ = database.seed_if_empty();
            (Some(database), None)
        }
        Err(error) => (None, Some(error.to_string())),
    }
}

/// Registers the app's font and themes. Call once, right after
/// `gpui_kit::init`, before opening a window.
///
/// # Errors
///
/// Returns an error when the embedded font or theme file is invalid.
pub fn init(cx: &mut App) -> anyhow::Result<()> {
    {{.crate_name}}_ui::theme::install(cx)
}

fn t(key: &str) -> String {
    rust_i18n::t!(key).to_string()
}
