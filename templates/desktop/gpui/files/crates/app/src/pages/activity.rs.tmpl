use super::*;

impl AppView {
    pub(crate) fn activity_body(&self, _cx: &mut Context<Self>) -> AnyElement {
        let conflicts = self
            .database
            .as_ref()
            .and_then(|database| database.conflicts().ok())
            .map_or(0, |rows| rows.len());
        let status = if self.sync_status.is_empty() {
            "No sync activity.".to_owned()
        } else {
            self.sync_status.clone()
        };

        v_flex()
            .w_full()
            .gap_4()
            .child(PageHeader::new(t("nav.activity")).subtitle("Background work and sync status."))
            .child(
                SectionCard::new("Sync")
                    .child(status)
                    .child(format!("{conflicts} pending conflicts")),
            )
            .into_any_element()
    }
}
