use super::*;

impl AppView {
    #[allow(clippy::too_many_lines)]
    pub(crate) fn library_body(&mut self, cx: &mut Context<Self>) -> AnyElement {
        let items = self
            .database
            .as_ref()
            .and_then(|database| database.list("", None).ok())
            .unwrap_or_default();
        let rows = items.into_iter().map(|item| {
            let id = item.id;
            let title = item.title.clone();
            TableRow::new()
                .id(id.to_string())
                .child(TableCell::new().child(item.title))
                .child(TableCell::new().child(status_tag(item.status)))
                .child(
                    TableCell::new().child(
                        Button::new(format!("delete-{id}"))
                            .ghost()
                            .xsmall()
                            .icon(IconName::Delete)
                            .tooltip(t("library.delete"))
                            .on_click(cx.listener(move |_, _, window, cx| {
                                let entity = cx.entity();
                                let title = title.clone();
                                window.open_alert_dialog(cx, move |alert, _, _| {
                                    let entity = entity.clone();
                                    alert
                                        .title(format!("{} \"{title}\"?", t("state.delete_title")))
                                        .description(t("state.delete_body"))
                                        .ok_text(t("state.delete_confirm"))
                                        .ok_variant(ButtonVariant::Danger)
                                        .cancel_text(t("common.cancel"))
                                        .show_cancel(true)
                                        .on_ok(move |_, _, cx| {
                                            entity.update(cx, |this, cx| {
                                                if let Some(database) = &this.database {
                                                    let _ = database.soft_delete(id);
                                                }
                                                cx.notify();
                                            });
                                            true
                                        })
                                });
                            })),
                    ),
                )
        });
        let rows: Vec<_> = rows.collect();

        let records = if rows.is_empty() {
            SectionCard::new(t("library.list"))
                .child(
                    EmptyState::new(IconName::BookOpen, t("dashboard.empty_title"))
                        .body(t("dashboard.empty_body")),
                )
                .into_any_element()
        } else {
            SectionCard::new(t("library.list"))
                .child(
                    Table::new()
                        .child(
                            TableHeader::new().child(
                                TableRow::new()
                                    .child(TableHead::new().child(t("library.title_field")))
                                    .child(TableHead::new().w_24().child(t("library.status")))
                                    .child(TableHead::new().w_12().child("")),
                            ),
                        )
                        .child(TableBody::new().children(rows)),
                )
                .into_any_element()
        };

        let create = SectionCard::new(t("library.new_title"))
            .child(
                v_flex()
                    .gap_1()
                    .child(
                        div()
                            .text_xs()
                            .text_color(cx.theme().muted_foreground)
                            .child(t("library.title_field")),
                    )
                    .child(Input::new(&self.title_input)),
            )
            .child(
                v_flex()
                    .gap_1()
                    .child(
                        div()
                            .text_xs()
                            .text_color(cx.theme().muted_foreground)
                            .child(t("library.tags_field")),
                    )
                    .child(Input::new(&self.tags_input)),
            )
            .child(
                h_flex().justify_end().child(
                    Button::new("create-item")
                        .primary()
                        .icon(IconName::Plus)
                        .label(t("library.create"))
                        .on_click(cx.listener(|this, _, window, cx| {
                            let title = this.title_input.read(cx).value().to_string();
                            if title.trim().is_empty() {
                                return;
                            }
                            let tags = this
                                .tags_input
                                .read(cx)
                                .value()
                                .split(',')
                                .map(str::trim)
                                .filter(|tag| !tag.is_empty())
                                .map(str::to_owned)
                                .collect();
                            if let Some(database) = &this.database {
                                let _ = database.create(&{{.crate_name}}_core::LibraryDraft {
                                    title,
                                    description: String::new(),
                                    status: {{.crate_name}}_core::LibraryStatus::Draft,
                                    tags,
                                });
                            }
                            this.title_input = cx.new(|cx| {
                                InputState::new(window, cx).placeholder(t("library.title_field"))
                            });
                            this.tags_input = cx.new(|cx| {
                                InputState::new(window, cx).placeholder(t("library.tags_hint"))
                            });
                            cx.notify();
                        })),
                ),
            );

        v_flex()
            .w_full()
            .gap_6()
            .child(PageHeader::new(t("nav.library")).subtitle(t("library.subtitle")))
            .child(
                h_flex()
                    .w_full()
                    .items_start()
                    .gap_4()
                    .child(div().flex_1().min_w_0().child(records))
                    .child(div().w_80().flex_none().child(create)),
            )
            .into_any_element()
    }
}
