/// A status chip. Only "Active" gets a colour; drafts and archived records
/// stay neutral so lists stay calm.
pub(crate) fn status_tag(status: LibraryStatus) -> Tag {
    let tag = match status {
        LibraryStatus::Active => Tag::success(),
        LibraryStatus::Draft | LibraryStatus::Archived => Tag::secondary(),
    };
    tag.small().child(status.label())
}

/// A settings row: label and help text on the leading side, a control on the
/// trailing side.
pub(crate) fn setting_row(
    label: impl Into<SharedString>,
    help: impl Into<SharedString>,
    control: impl IntoElement,
    cx: &App,
) -> impl IntoElement {
    h_flex()
        .w_full()
        .justify_between()
        .gap_4()
        .py_1()
        .child(
            v_flex()
                .gap_0p5()
                .child(div().text_sm().child(label.into()))
                .child(
                    div()
                        .text_xs()
                        .text_color(cx.theme().muted_foreground)
                        .child(help.into()),
                ),
        )
        .child(control)
}

/// A key–value line for details sections.
pub(crate) fn detail_row(
    key: impl Into<SharedString>,
    value: impl Into<SharedString>,
    cx: &App,
) -> impl IntoElement {
    h_flex()
        .gap_4()
        .text_sm()
        .child(
            div()
                .w_32()
                .flex_none()
                .text_color(cx.theme().muted_foreground)
                .child(key.into()),
        )
        .child(
            div()
                .font_family(cx.theme().mono_font_family.clone())
                .child(value.into()),
        )
}
