use {{.crate_name}}_core::LibraryStatus;

/// A status chip. Only "Active" gets a colour; drafts and archived records
/// stay neutral so lists stay calm.
pub(crate) fn status_tag(status: LibraryStatus) -> Tag {
    let tag = match status {
        LibraryStatus::Active => Tag::success(),
        LibraryStatus::Draft | LibraryStatus::Archived => Tag::secondary(),
    };
    tag.small().child(status.label())
}

/// A settings row: label and help text on the leading side, a control on the
/// trailing side.
pub(crate) fn setting_row(
    label: impl Into<SharedString>,
    help: impl Into<SharedString>,
    control: impl IntoElement,
    cx: &App,
) -> impl IntoElement {
    h_flex()
        .w_full()
        .justify_between()
        .gap_4()
        .py_1()
        .child(
            v_flex()
                .gap_0p5()
                .child(div().text_sm().child(label.into()))
                .child(
                    div()
                        .text_xs()
                        .text_color(cx.theme().muted_foreground)
                        .child(help.into()),
                ),
        )
        .child(control)
}

/// A key–value line for details sections.
pub(crate) fn detail_row(
    key: impl Into<SharedString>,
    value: impl Into<SharedString>,
    cx: &App,
) -> impl IntoElement {
    h_flex()
        .gap_4()
        .text_sm()
        .child(
            div()
                .w_32()
                .flex_none()
                .text_color(cx.theme().muted_foreground)
                .child(key.into()),
        )
        .child(
            div()
                .font_family(cx.theme().mono_font_family.clone())
                .child(value.into()),
        )
}

impl AppView {
    /// System / Light / Dark, shared by Settings and the welcome tour.
    pub(crate) fn theme_choice(&self, id: &'static str, cx: &mut Context<Self>) -> ButtonGroup {
        const CHOICES: [(&str, &str); 3] = [
            ("system", "setting.system"),
            ("light", "setting.light"),
            ("dark", "setting.dark"),
        ];
        ButtonGroup::new(id)
            .outline()
            .small()
            .children(CHOICES.iter().map(|(value, label)| {
                Button::new(SharedString::from(format!("{id}-{value}")))
                    .label(t(label))
                    .selected(self.settings.theme == *value)
            }))
            .on_click(cx.listener(|this, clicks: &Vec<usize>, _, cx| {
                if let Some((value, _)) = clicks.first().and_then(|index| CHOICES.get(*index)) {
                    (*value).clone_into(&mut this.settings.theme);
                    let _ = this.settings_store.save(&this.settings);
                    cx.notify();
                }
            }))
    }

    /// − 100% + for the interface size, shared by Settings and the welcome tour.
    pub(crate) fn size_stepper(&self, id: &'static str, cx: &mut Context<Self>) -> ValueStepper {
        let current = self.settings.zoom;
        let smaller = ui::theme::zoom::step(current, -ui::theme::zoom::STEP);
        let larger = ui::theme::zoom::step(current, ui::theme::zoom::STEP);
        ValueStepper::new(
            ui::theme::zoom::label(current),
            Button::new(SharedString::from(format!("{id}-smaller")))
                .ghost()
                .xsmall()
                .icon(IconName::Minus)
                .tooltip(t("setting.size_smaller"))
                .disabled((smaller - current).abs() < f32::EPSILON)
                .on_click(cx.listener(move |this, _, _, cx| this.set_zoom(smaller, cx))),
            Button::new(SharedString::from(format!("{id}-larger")))
                .ghost()
                .xsmall()
                .icon(IconName::Plus)
                .tooltip(t("setting.size_larger"))
                .disabled((larger - current).abs() < f32::EPSILON)
                .on_click(cx.listener(move |this, _, _, cx| this.set_zoom(larger, cx))),
        )
    }
}
