use super::*;

impl AppView {
    pub(crate) fn dashboard_body(&mut self, cx: &mut Context<Self>) -> AnyElement {
        let items = self
            .database
            .as_ref()
            .and_then(|database| database.list("", None).ok())
            .unwrap_or_default();
        let recent = items.iter().take(5).map(|item| {
            h_flex().gap_2().child(item.title.clone()).child(
                div()
                    .text_color(cx.theme().muted_foreground)
                    .child(item.status.label()),
            )
        });
        v_flex()
            .gap_5()
            .max_w(px(860.))
            .child(
                h_flex()
                    .gap_4()
                    .child(
                        v_flex()
                            .w(px(220.))
                            .p_5()
                            .rounded_lg()
                            .bg(cx.theme().secondary)
                            .border_1()
                            .border_color(cx.theme().border)
                            .gap_1()
                            .child(
                                div()
                                    .text_sm()
                                    .text_color(cx.theme().muted_foreground)
                                    .child("Library records"),
                            )
                            .child(
                                div()
                                    .text_3xl()
                                    .font_semibold()
                                    .child(items.len().to_string()),
                            ),
                    )
                    .child(
                        v_flex()
                            .w(px(220.))
                            .p_5()
                            .rounded_lg()
                            .bg(cx.theme().secondary)
                            .border_1()
                            .border_color(cx.theme().border)
                            .gap_1()
                            .child(
                                div()
                                    .text_sm()
                                    .text_color(cx.theme().muted_foreground)
                                    .child("Workspace"),
                            )
                            .child(div().text_3xl().font_semibold().child("Local")),
                    ),
            )
            .when(!self.settings.onboarded, |this| {
                this.child(
                    v_flex()
                        .gap_3()
                        .p_4()
                        .rounded_lg()
                        .bg(cx.theme().secondary)
                        .border_1()
                        .border_color(cx.theme().border)
                        .child("Welcome to Smokeforge. Start in the Library.")
                        .child(
                            Button::new("dismiss-onboarding")
                                .small()
                                .label("Got it")
                                .on_click(cx.listener(|this, _, _, cx| {
                                    this.settings.onboarded = true;
                                    let _ = this.settings_store.save(&this.settings);
                                    cx.notify();
                                })),
                        ),
                )
            })
            .child(
                v_flex()
                    .gap_2()
                    .p_4()
                    .rounded_lg()
                    .bg(cx.theme().secondary)
                    .border_1()
                    .border_color(cx.theme().border)
                    .child(div().text_lg().font_semibold().child("Recent records"))
                    .children(recent),
            )
            .into_any_element()
    }
}
