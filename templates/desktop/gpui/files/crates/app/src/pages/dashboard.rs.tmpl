use super::*;

use {{.crate_name}}_core::LibraryStatus;

const RECENT_LIMIT: usize = 5;

impl AppView {
    #[allow(clippy::too_many_lines)]
    pub(crate) fn dashboard_body(&mut self, cx: &mut Context<Self>) -> AnyElement {
        let items = self
            .database
            .as_ref()
            .and_then(|database| database.list("", None).ok())
            .unwrap_or_default();
        let count =
            |status: LibraryStatus| items.iter().filter(|item| item.status == status).count();

        let recent: Vec<_> = items
            .iter()
            .take(RECENT_LIMIT)
            .map(|item| {
                let tags = if item.tags.is_empty() {
                    t("library.no_tags")
                } else {
                    item.tags.join(", ")
                };
                h_flex()
                    .id(SharedString::from(format!("recent-{}", item.id)))
                    .w_full()
                    .justify_between()
                    .gap_3()
                    .px_3()
                    .py_2()
                    .rounded(cx.theme().radius)
                    .hover(|style| style.bg(cx.theme().list_hover))
                    .child(
                        v_flex()
                            .min_w_0()
                            .child(div().text_sm().truncate().child(item.title.clone()))
                            .child(
                                div()
                                    .text_xs()
                                    .truncate()
                                    .text_color(cx.theme().muted_foreground)
                                    .child(tags),
                            ),
                    )
                    .child(status_tag(item.status))
                    .on_click(cx.listener(|this, _, _, cx| {
                        this.active = Pane::Library;
                        cx.notify();
                    }))
            })
            .collect();

        let new_record = Button::new("dashboard-new-record")
            .primary()
            .icon(IconName::Plus)
            .label(t("library.new"))
            .on_click(cx.listener(|this, _, _, cx| {
                this.active = Pane::Library;
                cx.notify();
            }));

        v_flex()
            .w_full()
            .gap_6()
            .child(
                PageHeader::new(t("nav.dashboard"))
                    .subtitle(t("dashboard.subtitle"))
                    .action(new_record),
            )
            .child(
                h_flex()
                    .w_full()
                    .flex_wrap()
                    .gap_3()
                    .child(StatCard::new(
                        IconName::BookOpen,
                        t("dashboard.records"),
                        items.len().to_string(),
                    ))
                    .child(StatCard::new(
                        IconName::CircleCheck,
                        t("dashboard.active"),
                        count(LibraryStatus::Active).to_string(),
                    ))
                    .child(StatCard::new(
                        IconName::FileText,
                        t("dashboard.drafts"),
                        count(LibraryStatus::Draft).to_string(),
                    ))
                    .child(StatCard::new(
                        IconName::FolderClosed,
                        t("dashboard.archived"),
                        count(LibraryStatus::Archived).to_string(),
                    )),
            )
            .child(if recent.is_empty() {
                SectionCard::new(t("dashboard.recent"))
                    .child(
                        EmptyState::new(IconName::BookOpen, t("dashboard.empty_title"))
                            .body(t("dashboard.empty_body")),
                    )
                    .into_any_element()
            } else {
                SectionCard::new(t("dashboard.recent"))
                    .child(v_flex().gap_0p5().children(recent))
                    .into_any_element()
            })
            .into_any_element()
    }
}
