appId: {{.bundle_id}}
productName: {{.project_name}}
directories:
  output: dist
files:
  - out/**/*
  # smokeforge:anchor files-entry
  - package.json
extraResources:
  - from: resources/icon.png
    to: icon.png
  # smokeforge:anchor extra-resources
asar: true
afterPack: scripts/after-pack.cjs
mac:
  icon: resources/icon.icns
  target:
    - dmg
    - zip
  hardenedRuntime: true
  gatekeeperAssess: false
  entitlements: resources/entitlements.mac.plist
  entitlementsInherit: resources/entitlements.mac.plist
win:
  icon: resources/icon.ico
  target:
    - nsis
linux:
  icon: resources/icon.png
  target:
    - AppImage
    - deb
  category: Utility
  # GNOME/KDE on Wayland pick the dock icon by matching the window's app_id to
  # a desktop entry. package.json "desktopName" makes the app_id the bundle id;
  # this makes the installed entry claim it.
  desktop:
    entry:
      StartupWMClass: {{.bundle_id}}
