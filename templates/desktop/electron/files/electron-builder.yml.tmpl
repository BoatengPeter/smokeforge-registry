appId: {{.bundle_id}}
productName: {{.project_name}}
directories:
  output: dist
files:
  - out/**/*
  - package.json
asar: true
afterPack: scripts/after-pack.cjs
mac:
  target:
    - dmg
    - zip
  hardenedRuntime: true
  gatekeeperAssess: false
  entitlements: resources/entitlements.mac.plist
  entitlementsInherit: resources/entitlements.mac.plist
win:
  target:
    - nsis
linux:
  target:
    - AppImage
    - deb
  category: Utility
