    "date-fns": "4.4.0",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.11",
    "electron-window-state": "5.0.3",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "7.0.7",
    "i18next": "27.1.5",
    "lucide-react": "1.75.0",
    "motion": "14.14.0",
    "next-themes": "0.4.6",
    "p-queue": "10.0.0",
    "radix-ui": "1.8.1",
    "react-hook-form": "7.92.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "18.0.2",
    "react-is": "19.3.1",
    "react-resizable-panels": "4.24.0",
    "react-router": "8.5.1",
    "recharts": "3.11.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
