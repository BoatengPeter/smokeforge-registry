{
  "name": "{{.project_slug}}",
  "version": "0.1.0",
  "private": true,
  "description": "{{.project_name}} desktop app",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:dir": "electron-vite build && electron-builder --dir",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.renderer.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
