//! Thin egui application shell and feature views.

use std::sync::Mutex;

use eframe::egui;
use egui::{Color32, Key, KeyboardShortcut, Modifiers, RichText};
use egui_tiles::{Behavior, Tile, TileId, Tree, UiResponse};
use garde::Validate;

use {{.crate_name}}_core::{LibraryDraft, LibraryStatus};
use {{.crate_name}}_storage::{Database, Paths, Settings, SettingsStore};

pub mod commands;
pub mod credentials;
pub mod logging;
pub mod sync;
pub mod theme;

use commands::Command;

rust_i18n::i18n!("locales");

#[derive(Debug, Clone, Copy, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
pub enum Pane {
    Dashboard,
    Library,
    Activity,
    Settings,
    Account,
    About,
}

impl Pane {
    fn title_key(self) -> &'static str {
        match self {
            Self::Dashboard => "dashboard.title",
            Self::Library => "library.title",
            Self::Activity => "activity.title",
            Self::Settings => "settings.title",
            Self::Account => "account.title",
            Self::About => "about.title",
        }
    }

    fn all(api_mode: bool) -> Vec<Self> {
        let mut panes = vec![
            Self::Dashboard,
            Self::Library,
            Self::Activity,
            Self::Settings,
        ];
        if api_mode {
            panes.push(Self::Account);
        }
        panes.push(Self::About);
        panes
    }
}

#[derive(Debug, Clone)]
pub enum Action {
    Navigate(Pane),
    ToggleSidebar,
    ToggleTheme,
    SearchChanged(String),
    Select(Option<uuid::Uuid>),
    NewRecord,
    SaveDraft,
    DeleteRecord,
    SetLanguage(String),
    OpenPalette,
    ClosePalette,
    RunCommand(Command),
    ToggleHighContrast,
    UndoDelete,
}

pub struct DesktopApp {
    pub paths: Paths,
    pub settings: Settings,
    pub settings_store: SettingsStore,
    pub database: Mutex<Database>,
    pub tree: Tree<Pane>,
    pub pane: Pane,
    pub search: String,
    pub selected: Option<uuid::Uuid>,
    pub draft: LibraryDraft,
    pub toasts: egui_notify::Toasts,
    pub palette_open: bool,
    pub palette_query: String,
    pub logging_guard: logging::LoggingGuard,
    pub last_deleted: Option<uuid::Uuid>,
    pub form_error: Option<String>,
    pub tokens: credentials::TokenStore,
    pub api_mode: bool,
    pub api_base: String,
    pub auth_state: AuthState,
    pub auth_email: String,
    pub auth_password: String,
    pub auth_rx: Option<std::sync::mpsc::Receiver<AuthMessage>>,
    pub access_token: Option<String>,
    pub sync_rx: Option<std::sync::mpsc::Receiver<sync::SyncReport>>,
    pub sync_status: String,
}

#[derive(Debug)]
pub enum AuthState {
    SignedOut,
    Loading,
    SignedIn(String),
    Failed(String),
}

pub enum AuthMessage {
    Session(api_client::ApiSession),
    Failed(String),
}

impl DesktopApp {
    /// Creates the window state, database, settings, and tiled workspace.
    ///
    /// # Errors
    ///
    /// Returns an error when paths, settings, migrations, or the database
    /// cannot be initialized.
    pub fn new(app_name: &str) -> anyhow::Result<Self> {
        let paths = Paths::discover(app_name)?;
        let settings_store = SettingsStore::new(&paths.config);
        let settings = settings_store.load()?;
        rust_i18n::set_locale(&settings.locale);
        let logging_guard = logging::init(&paths.logs, "info");
        let database = Database::open(&paths.data.join("local.sqlite"))?;
        let api_mode = std::env::var("SMOKEFORGE_API_MODE")
            .is_ok_and(|value| matches!(value.as_str(), "api" | "1" | "true"));
        if !api_mode {
            database.seed_if_empty()?;
        }
        let panes = Pane::all(api_mode)
            .into_iter()
            .map(|pane| (pane, true))
            .collect::<Vec<_>>();
        let tree = Tree::new_tabs(
            egui::Id::unique("workspace"),
            panes.into_iter().map(|(pane, _)| pane).collect(),
        );
        Ok(Self {
            paths,
            settings,
            settings_store,
            database: Mutex::new(database),
            tree,
            pane: Pane::Dashboard,
            search: String::new(),
            selected: None,
            draft: LibraryDraft::default(),
            toasts: egui_notify::Toasts::default(),
            palette_open: false,
            palette_query: String::new(),
            logging_guard,
            last_deleted: None,
            form_error: None,
            tokens: credentials::TokenStore::new("smokeforge-egui", "auth"),
            api_mode,
            api_base: std::env::var("SMOKEFORGE_API_URL")
                .unwrap_or_else(|_| "http://localhost:8080".to_owned()),
            auth_state: AuthState::SignedOut,
            auth_email: String::new(),
            auth_password: String::new(),
            auth_rx: None,
            access_token: None,
            sync_rx: None,
            sync_status: String::new(),
        })
    }

    /// Builds a temporary app for UI tests.
    ///
    /// # Panics
    ///
    /// Panics if the temporary `SQLite` database cannot be created.
    #[cfg(test)]
    #[must_use]
    pub fn for_tests() -> Self {
        let root =
            std::env::temp_dir().join(format!("smokeforge-egui-test-{}", uuid::Uuid::new_v4()));
        let _ = std::fs::create_dir_all(root.join("data"));
        let _ = std::fs::create_dir_all(root.join("config"));
        let paths = Paths {
            data: root.join("data"),
            config: root.join("config"),
            logs: root.join("logs"),
        };
        let database = Database::open(&paths.data.join("local.sqlite")).unwrap();
        database.seed_if_empty().unwrap();
        let tree = Tree::new_tabs(
            egui::Id::unique("workspace-test"),
            Pane::all(false).into_iter().collect(),
        );
        let settings_store = SettingsStore::new(&paths.config);
        Self {
            paths,
            settings: Settings::default(),
            settings_store,
            database: Mutex::new(database),
            tree,
            pane: Pane::Dashboard,
            search: String::new(),
            selected: None,
            draft: LibraryDraft::default(),
            toasts: egui_notify::Toasts::default(),
            palette_open: false,
            palette_query: String::new(),
            logging_guard: logging::LoggingGuard::disabled(),
            last_deleted: None,
            form_error: None,
            tokens: credentials::TokenStore::memory_only(),
            api_mode: false,
            api_base: "http://localhost:8080".to_owned(),
            auth_state: AuthState::SignedOut,
            auth_email: String::new(),
            auth_password: String::new(),
            auth_rx: None,
            access_token: None,
            sync_rx: None,
            sync_status: String::new(),
        }
    }

    pub fn restore_layout(&mut self, storage: &dyn eframe::Storage) {
        if let Some(state) = eframe::get_value::<LayoutState>(storage, eframe::APP_KEY) {
            self.tree = state.tree;
            self.pane = state.pane;
        }
    }

    pub fn save_layout(&self, storage: &mut dyn eframe::Storage) {
        let state = LayoutState {
            tree: self.tree.clone(),
            pane: self.pane,
        };
        eframe::set_value(storage, eframe::APP_KEY, &state);
    }

    #[allow(clippy::too_many_lines)]
    pub fn dispatch(&mut self, action: Action) {
        match action {
            Action::Navigate(pane) => {
                self.pane = pane;
                self.tree
                    .make_active(|_, tile| matches!(tile, Tile::Pane(p) if *p == pane));
            }
            Action::ToggleSidebar => self.settings.sidebar_open = !self.settings.sidebar_open,
            Action::ToggleTheme => {
                self.settings.theme = match self.settings.theme.as_str() {
                    "dark" => "light".to_owned(),
                    _ => "dark".to_owned(),
                };
            }
            Action::SearchChanged(search) => self.search = search,
            Action::Select(id) => {
                self.selected = id;
                self.draft = id
                    .and_then(|id| {
                        self.database
                            .lock()
                            .ok()
                            .and_then(|db| db.get(id).ok().flatten())
                    })
                    .map(|item| LibraryDraft::from(&item))
                    .unwrap_or_default();
            }
            Action::NewRecord => {
                self.selected = None;
                self.form_error = None;
                self.draft = LibraryDraft::default();
                self.dispatch(Action::Navigate(Pane::Library));
            }
            Action::SaveDraft => {
                if let Err(report) = self.draft.validate() {
                    self.form_error = Some(report.to_string());
                    self.toasts
                        .error("Fix the highlighted fields before saving.");
                    return;
                }
                self.form_error = None;

                let result = self
                    .database
                    .lock()
                    .map_err(|_| anyhow::anyhow!("database lock"));
                if let Ok(database) = result {
                    if let Some(id) = self.selected {
                        match database.update(id, &self.draft) {
                            Ok(Some(item)) => {
                                self.queue_outbox(&database, "update", &item);
                                self.toasts.success("Record saved.");
                            }
                            Ok(None) => {
                                self.toasts.error("Record not found.");
                            }
                            Err(error) => {
                                self.toasts.error(error.to_string());
                            }
                        }
                    } else {
                        match database.create(&self.draft) {
                            Ok(item) => {
                                self.queue_outbox(&database, "create", &item);
                                self.selected = Some(item.id);
                                self.toasts.success("Record created.");
                            }
                            Err(error) => {
                                self.toasts.error(error.to_string());
                            }
                        }
                    }
                }
            }
            Action::DeleteRecord => {
                if let Some(id) = self.selected
                    && let Ok(database) = self.database.lock()
                {
                    match database.soft_delete(id) {
                        Ok(true) => {
                            if let Ok(Some(item)) = database.get(id) {
                                self.queue_outbox(&database, "delete", &item);
                            }
                            self.last_deleted = Some(id);
                            self.selected = None;
                            self.draft = LibraryDraft::default();
                            self.toasts
                                .success("Record deleted. Use Undo in the status bar.");
                        }
                        Ok(false) => {
                            self.toasts.error("Record not found.");
                        }
                        Err(error) => {
                            self.toasts.error(error.to_string());
                        }
                    }
                }
            }
            Action::SetLanguage(language) => {
                self.settings.language.clone_from(&language);
                self.settings.locale.clone_from(&language);
                rust_i18n::set_locale(&language);
            }
            Action::OpenPalette => {
                self.palette_open = true;
                self.palette_query.clear();
            }
            Action::ClosePalette => self.palette_open = false,
            Action::RunCommand(command) => self.run_command(command),
            Action::ToggleHighContrast => {
                self.settings.high_contrast = !self.settings.high_contrast;
            }
            Action::UndoDelete => {
                if let Some(id) = self.last_deleted.take()
                    && let Ok(database) = self.database.lock()
                {
                    match database.restore(id) {
                        Ok(Some(item)) => {
                            self.selected = Some(item.id);
                            self.toasts.success("Record restored.");
                        }
                        Ok(None) => {
                            self.toasts.error("Record no longer exists.");
                        }
                        Err(error) => {
                            self.toasts.error(error.to_string());
                        }
                    }
                }
            }
        }
        let _ = self.settings_store.save(&self.settings);
    }

    pub fn render(&mut self, ui: &mut egui::Ui) {
        self.poll_auth();
        self.poll_sync();
        self.handle_shortcuts(ui);
        theme::apply_visuals(ui.ctx(), &self.settings.theme, self.settings.high_contrast);
        Self::title_bar(ui);
        let content_height = (ui.available_height() - 30.0).max(80.0);
        ui.horizontal(|ui| {
            self.sidebar(ui, content_height);
            ui.separator();
            ui.allocate_ui_with_layout(
                egui::vec2(ui.available_width(), content_height),
                egui::Layout::top_down(egui::Align::Min),
                |ui| {
                    let mut tree = std::mem::replace(
                        &mut self.tree,
                        Tree::empty(egui::Id::unique("workspace")),
                    );
                    let mut behavior = PaneBehavior { app: self };
                    tree.ui(&mut behavior, ui);
                    self.tree = tree;
                },
            );
        });
        self.status_bar(ui);
        self.command_palette(ui);
        self.toasts.show(ui.ctx());
    }

    fn handle_shortcuts(&mut self, ui: &mut egui::Ui) {
        const PALETTE: KeyboardShortcut = KeyboardShortcut::new(Modifiers::COMMAND, Key::K);
        const NEW_RECORD: KeyboardShortcut = KeyboardShortcut::new(Modifiers::COMMAND, Key::N);
        const SIDEBAR: KeyboardShortcut = KeyboardShortcut::new(Modifiers::COMMAND, Key::B);

        if ui.input_mut(|input| input.consume_shortcut(&PALETTE)) {
            self.palette_open = !self.palette_open;
            self.palette_query.clear();
        }
        if ui.input_mut(|input| input.consume_shortcut(&NEW_RECORD)) {
            self.dispatch(Action::NewRecord);
        }
        if ui.input_mut(|input| input.consume_shortcut(&SIDEBAR)) {
            self.dispatch(Action::ToggleSidebar);
        }
        if self.palette_open && ui.input(|input| input.key_pressed(Key::Escape)) {
            self.palette_open = false;
        }
    }

    fn command_palette(&mut self, ui: &mut egui::Ui) {
        if !self.palette_open {
            return;
        }

        let mut chosen = None;
        let mut close = false;
        egui::Window::new(t("command.title"))
            .id(egui::Id::unique("command-palette"))
            .collapsible(false)
            .resizable(false)
            .default_width(440.0)
            .show(ui.ctx(), |ui| {
                ui.add(
                    egui::TextEdit::singleline(&mut self.palette_query)
                        .hint_text(t("command.placeholder")),
                );
                ui.add_space(6.0);
                let commands =
                    commands::filter_commands(
                        &self.palette_query,
                        |command| t(command.label_key()),
                    );
                if commands.is_empty() {
                    ui.label(RichText::new(t("command.empty")).color(theme::TEXT_SECONDARY));
                }
                for command in commands {
                    if ui.button(t(command.label_key())).clicked() {
                        chosen = Some(command);
                        close = true;
                    }
                }
            });

        if close {
            self.palette_open = false;
            self.palette_query.clear();
        }
        if let Some(command) = chosen {
            self.dispatch(Action::RunCommand(command));
        }
    }

    fn run_command(&mut self, command: Command) {
        match command {
            Command::Navigate(pane) => self.dispatch(Action::Navigate(pane)),
            Command::NewRecord => self.dispatch(Action::NewRecord),
            Command::ToggleSidebar => self.dispatch(Action::ToggleSidebar),
            Command::ToggleTheme => self.dispatch(Action::ToggleTheme),
            Command::ToggleHighContrast => self.dispatch(Action::ToggleHighContrast),
        }
    }

    fn title_bar(ui: &mut egui::Ui) {
        let (rect, response) = ui.allocate_exact_size(
            egui::vec2(ui.available_width(), 38.0),
            egui::Sense::click_and_drag(),
        );
        if response.drag_started() {
            ui.ctx().send_viewport_cmd(egui::ViewportCommand::StartDrag);
        }

        ui.painter().rect_filled(rect, 0.0, theme::TITLE_BAR);
        let left_padding = if cfg!(target_os = "macos") {
            78.0
        } else {
            16.0
        };
        ui.painter().text(
            rect.left_center() + egui::vec2(left_padding, 0.0),
            egui::Align2::LEFT_CENTER,
            t("app.name"),
            egui::FontId::proportional(13.0),
            theme::TEXT,
        );

        if cfg!(target_os = "macos") {
            return;
        }

        let controls = [
            ("-", "Minimize", egui::ViewportCommand::Minimized(true)),
            ("[]", "Maximize", egui::ViewportCommand::Maximized(true)),
            ("x", "Close", egui::ViewportCommand::Close),
        ];
        let mut right = rect.right() - 6.0;
        for (label, name, command) in controls {
            let button_rect = egui::Rect::from_min_size(
                egui::pos2(right - 30.0, rect.center().y - 13.0),
                egui::vec2(28.0, 26.0),
            );
            if ui
                .put(button_rect, egui::Button::new(label).frame(false))
                .on_hover_text(name)
                .clicked()
            {
                ui.ctx().send_viewport_cmd(command);
            }
            right -= 32.0;
        }
    }

    fn sidebar(&mut self, ui: &mut egui::Ui, height: f32) {
        let width = if self.settings.sidebar_open {
            208.0
        } else {
            48.0
        };
        ui.allocate_ui_with_layout(
            egui::vec2(width, height),
            egui::Layout::top_down(egui::Align::Min),
            |ui| {
                ui.add_space(8.0);
                for pane in Pane::all(self.api_mode) {
                    let label = if self.settings.sidebar_open {
                        t(pane.title_key())
                    } else {
                        icon(pane).to_owned()
                    };
                    let selected = pane == self.pane;
                    if ui
                        .add_sized(
                            egui::vec2(ui.available_width(), 32.0),
                            egui::Button::new(RichText::new(label).color(if selected {
                                theme::ON_SELECTION
                            } else {
                                theme::TEXT_SECONDARY
                            }))
                            .fill(if selected {
                                theme::SELECTED_BACKGROUND
                            } else {
                                Color32::TRANSPARENT
                            }),
                        )
                        .clicked()
                    {
                        self.dispatch(Action::Navigate(pane));
                    }
                }
                ui.with_layout(egui::Layout::bottom_up(egui::Align::Center), |ui| {
                    let toggle = if self.settings.sidebar_open { "<" } else { ">" };
                    if ui.button(toggle).on_hover_text("Toggle sidebar").clicked() {
                        self.dispatch(Action::ToggleSidebar);
                    }
                });
            },
        );
    }

    fn status_bar(&mut self, ui: &mut egui::Ui) {
        ui.separator();
        ui.horizontal(|ui| {
            ui.label(
                RichText::new("Online · Local".to_owned())
                    .small()
                    .color(theme::SUCCESS),
            );
            if self.last_deleted.is_some() && ui.small_button("Undo").clicked() {
                self.dispatch(Action::UndoDelete);
            }
            ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
                ui.label(RichText::new("v0.1.0").small().color(theme::TEXT_SECONDARY));
                ui.label(
                    RichText::new("Ctrl/Cmd+K")
                        .small()
                        .color(theme::TEXT_SECONDARY),
                );
            });
        });
    }

    fn dashboard(&mut self, ui: &mut egui::Ui) {
        ui.heading(t("dashboard.title"));
        ui.label(RichText::new(t("dashboard.subtitle")).color(theme::TEXT_SECONDARY));
        ui.add_space(16.0);
        let items = self
            .database
            .lock()
            .ok()
            .and_then(|db| db.list("", None).ok())
            .unwrap_or_default();
        ui.horizontal(|ui| {
            stat(ui, t("dashboard.records"), items.len().to_string());
            stat(
                ui,
                t("dashboard.stats"),
                format!(
                    "{} active",
                    items
                        .iter()
                        .filter(|item| item.status == LibraryStatus::Active)
                        .count()
                ),
            );
        });
        ui.add_space(16.0);
        ui.heading(t("dashboard.recent"));
        for item in items.iter().take(5) {
            if ui
                .button(format!("{}  ·  {}", item.title, item.status.label()))
                .clicked()
            {
                self.dispatch(Action::Navigate(Pane::Library));
                self.dispatch(Action::Select(Some(item.id)));
            }
        }
    }

    fn library(&mut self, ui: &mut egui::Ui) {
        ui.horizontal(|ui| {
            ui.heading(t("library.title"));
            ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
                if ui.button(t("library.new")).clicked() {
                    self.dispatch(Action::NewRecord);
                }
            });
        });
        let mut search = self.search.clone();
        ui.add(egui::TextEdit::singleline(&mut search).hint_text(t("library.search")));
        if search != self.search {
            self.dispatch(Action::SearchChanged(search));
        }
        let items = self
            .database
            .lock()
            .ok()
            .and_then(|db| db.list(&self.search, None).ok())
            .unwrap_or_default();
        ui.horizontal(|ui| {
            ui.allocate_ui_with_layout(
                egui::vec2(ui.available_width() * 0.42, ui.available_height()),
                egui::Layout::top_down(egui::Align::Min),
                |ui| {
                    if items.is_empty() {
                        ui.label(t("library.empty"));
                    } else {
                        egui::ScrollArea::vertical().show_rows(
                            ui,
                            34.0,
                            items.len(),
                            |ui, range| {
                                for index in range {
                                    let item = &items[index];
                                    let selected = self.selected == Some(item.id);
                                    if ui
                                        .add_sized(
                                            egui::vec2(ui.available_width(), 34.0),
                                            egui::Button::new(format!(
                                                "{}  ·  {}",
                                                item.title,
                                                item.status.label()
                                            ))
                                            .selected(selected),
                                        )
                                        .clicked()
                                    {
                                        self.dispatch(Action::Select(Some(item.id)));
                                    }
                                }
                            },
                        );
                    }
                },
            );
            ui.separator();
            ui.vertical(|ui| {
                if self.selected.is_none() {
                    ui.label(RichText::new(t("library.select")).color(theme::TEXT_SECONDARY));
                } else {
                    if let Some(error) = &self.form_error {
                        ui.label(RichText::new(error).color(ui.visuals().error_fg_color));
                    }
                    ui.label(t("library.title_field"));
                    ui.text_edit_singleline(&mut self.draft.title);
                    ui.label(t("library.description_field"));
                    ui.text_edit_multiline(&mut self.draft.description);
                    ui.label(t("library.tags_field"));
                    let mut tags = self.draft.tags.join(", ");
                    if ui.text_edit_singleline(&mut tags).changed() {
                        self.draft.tags = tags
                            .split(',')
                            .map(str::trim)
                            .filter(|tag| !tag.is_empty())
                            .map(str::to_owned)
                            .collect();
                    }
                    ui.horizontal(|ui| {
                        if ui.button(t("library.save")).clicked() {
                            self.dispatch(Action::SaveDraft);
                        }
                        if ui.button(t("library.delete")).clicked() {
                            self.dispatch(Action::DeleteRecord);
                        }
                    });
                }
            });
        });
    }

    fn activity(&mut self, ui: &mut egui::Ui) {
        ui.heading(t("activity.title"));
        ui.label(RichText::new(t("activity.subtitle")).color(theme::TEXT_SECONDARY));
        ui.add_space(16.0);
        if !self.sync_status.is_empty() {
            ui.label(&self.sync_status);
        }
        let conflicts = self.database.lock().ok().map_or(0, |database| {
            database.conflicts().map_or(0, |rows| rows.len())
        });
        ui.label(format!("{} pending sync conflicts", conflicts));
        ui.add_space(12.0);
        ui.label(t("activity.empty"));
    }

    fn settings(&mut self, ui: &mut egui::Ui) {
        ui.heading(t("settings.title"));
        ui.label(RichText::new(t("settings.subtitle")).color(theme::TEXT_SECONDARY));
        ui.add_space(16.0);
        self.settings_appearance(ui);
        self.settings_data(ui);
    }

    fn settings_appearance(&mut self, ui: &mut egui::Ui) {
        ui.label(t("settings.theme"));
        ui.horizontal(|ui| {
            for (value, label) in [("dark", "dark"), ("light", "light"), ("system", "system")] {
                if ui
                    .selectable_label(
                        self.settings.theme == value,
                        t(&format!("settings.{label}")),
                    )
                    .clicked()
                {
                    value.clone_into(&mut self.settings.theme);
                    let _ = self.settings_store.save(&self.settings);
                }
            }
        });
        ui.label(t("settings.language"));
        ui.horizontal(|ui| {
            for (value, label) in [("en", "English"), ("es", "Español")] {
                if ui
                    .selectable_label(self.settings.language == value, label)
                    .clicked()
                {
                    self.dispatch(Action::SetLanguage(value.to_owned()));
                }
            }
        });
        let mut high_contrast = self.settings.high_contrast;
        if ui
            .checkbox(&mut high_contrast, t("settings.high_contrast"))
            .changed()
        {
            self.settings.high_contrast = high_contrast;
            let _ = self.settings_store.save(&self.settings);
        }
    }

    fn settings_data(&mut self, ui: &mut egui::Ui) {
        ui.add_space(16.0);
        ui.label(t("settings.database"));
        ui.label(RichText::new(self.paths.data.join("local.sqlite").display().to_string()).small());
        if let Some(warning) = self.tokens.warning() {
            ui.label(RichText::new(warning).color(ui.visuals().warn_fg_color));
        }
        let conflicts = self
            .database
            .lock()
            .ok()
            .and_then(|database| database.conflicts().ok())
            .unwrap_or_default();
        for (item_id, _, _) in conflicts {
            ui.horizontal(|ui| {
                ui.label(format!("Conflict: {item_id}"));
                if ui.small_button("Keep local").clicked() {
                    match self.resolve_conflict(&item_id, true) {
                        Ok(()) => {
                            self.toasts.success("Kept local record.");
                        }
                        Err(error) => {
                            self.toasts.error(error);
                        }
                    }
                }
                if ui.small_button("Use server").clicked() {
                    match self.resolve_conflict(&item_id, false) {
                        Ok(()) => {
                            self.toasts.success("Applied server record.");
                        }
                        Err(error) => {
                            self.toasts.error(error);
                        }
                    }
                }
            });
        }
        ui.horizontal(|ui| {
            if ui.button("Export Library").clicked()
                && let Some(path) = rfd::FileDialog::new()
                    .set_file_name("library.json")
                    .save_file()
            {
                match self.export_library(&path) {
                    Ok(()) => {
                        self.toasts.success("Library exported.");
                    }
                    Err(error) => {
                        self.toasts.error(error);
                    }
                }
            }

            if ui.button("Import Library").clicked()
                && let Some(path) = rfd::FileDialog::new().pick_file()
            {
                match self.import_library(&path) {
                    Ok(count) => {
                        self.toasts.success(format!("Imported {count} records."));
                    }
                    Err(error) => {
                        self.toasts.error(error);
                    }
                }
            }

            if ui.button("Back up database").clicked()
                && let Some(path) = rfd::FileDialog::new()
                    .set_file_name("local-backup.sqlite")
                    .save_file()
            {
                match self.backup_database(&path) {
                    Ok(()) => {
                        self.toasts.success("Database backed up.");
                    }
                    Err(error) => {
                        self.toasts.error(error);
                    }
                }
            }

            if ui.button("Clear local data").clicked() {
                let confirmed = rfd::MessageDialog::new()
                    .set_title("Clear local data")
                    .set_description("Delete all local Library records? This cannot be undone.")
                    .set_buttons(rfd::MessageButtons::YesNo)
                    .show()
                    == rfd::MessageDialogResult::Yes;
                if confirmed {
                    match self.clear_local_data() {
                        Ok(count) => {
                            self.toasts.success(format!("Cleared {count} records."));
                        }
                        Err(error) => {
                            self.toasts.error(error);
                        }
                    }
                }
            }
        });
    }

    fn export_library(&self, path: &std::path::Path) -> Result<(), String> {
        let database = self
            .database
            .lock()
            .map_err(|_| "database lock".to_owned())?;
        let raw = database.export_json().map_err(|error| error.to_string())?;
        std::fs::write(path, raw).map_err(|error| error.to_string())
    }

    fn import_library(&self, path: &std::path::Path) -> Result<usize, String> {
        let raw = std::fs::read_to_string(path).map_err(|error| error.to_string())?;
        let database = self
            .database
            .lock()
            .map_err(|_| "database lock".to_owned())?;
        database
            .import_json(&raw)
            .map_err(|error| error.to_string())
    }

    fn backup_database(&self, path: &std::path::Path) -> Result<(), String> {
        let database = self
            .database
            .lock()
            .map_err(|_| "database lock".to_owned())?;
        database.backup(path).map_err(|error| error.to_string())
    }

    fn resolve_conflict(&self, item_id: &str, keep_local: bool) -> Result<(), String> {
        let database = self
            .database
            .lock()
            .map_err(|_| "database lock".to_owned())?;
        if keep_local {
            database
                .resolve_conflict_local(item_id)
                .map_err(|error| error.to_string())
        } else {
            database
                .resolve_conflict_remote(item_id)
                .map_err(|error| error.to_string())
        }
    }

    fn clear_local_data(&self) -> Result<usize, String> {
        let database = self
            .database
            .lock()
            .map_err(|_| "database lock".to_owned())?;
        database.clear_library().map_err(|error| error.to_string())
    }

    fn queue_outbox(
        &self,
        database: &{{.crate_name}}_storage::Database,
        operation: &str,
        item: &{{.crate_name}}_core::LibraryItem,
    ) {
        let key = format!("{operation}-{}", uuid::Uuid::new_v4());
        if let Ok(payload) = serde_json::to_string(item) {
            let _ = database.enqueue_outbox(&key, &item.id.to_string(), operation, &payload, &key);
        }
    }

    fn poll_auth(&mut self) {
        let Some(receiver) = &self.auth_rx else {
            return;
        };
        while let Ok(message) = receiver.try_recv() {
            match message {
                AuthMessage::Session(session) => {
                    self.tokens.set(&session.refresh_token).ok();
                    self.access_token = Some(session.access_token);
                    self.auth_state = AuthState::SignedIn(self.auth_email.clone());
                    self.auth_password.clear();
                }
                AuthMessage::Failed(error) => {
                    self.auth_state = AuthState::Failed(error);
                }
            }
        }
    }

    fn poll_sync(&mut self) {
        let Some(receiver) = &self.sync_rx else {
            return;
        };
        while let Ok(report) = receiver.try_recv() {
            self.sync_status = format!(
                "Synced {} · conflicts {} · retried {}",
                report.pushed, report.conflicts, report.retried
            );
            if let Some(error) = report.error {
                self.sync_status = error;
            }
        }
    }

    fn start_sync(&mut self) {
        let Some(token) = self.access_token.clone() else {
            self.sync_status = "Sign in before syncing.".to_owned();
            return;
        };
        let (sender, receiver) = std::sync::mpsc::channel();
        self.sync_rx = Some(receiver);
        let path = self.paths.data.join("local.sqlite");
        let base = self.api_base.clone();
        std::thread::spawn(move || {
            let report = sync::run(path, base, token);
            let _ = sender.send(report);
        });
    }

    fn account(&mut self, ui: &mut egui::Ui) {
        ui.heading(t("account.title"));
        ui.label(RichText::new(t("account.subtitle")).color(theme::TEXT_SECONDARY));
        ui.add_space(16.0);
        match &self.auth_state {
            AuthState::SignedIn(email) => {
                ui.label(format!("Signed in as {email}"));
                if ui.button("Sync now").clicked() {
                    self.start_sync();
                }
                if !self.sync_status.is_empty() {
                    ui.label(&self.sync_status);
                }
                if ui.button(t("account.sign_out")).clicked() {
                    self.access_token = None;
                    self.tokens.delete().ok();
                    self.auth_state = AuthState::SignedOut;
                }
            }
            AuthState::Loading => {
                ui.spinner();
                ui.label(t("common.loading"));
            }
            AuthState::SignedOut | AuthState::Failed(_) => {
                if let AuthState::Failed(error) = &self.auth_state {
                    ui.label(RichText::new(error).color(ui.visuals().error_fg_color));
                }
                ui.label(t("account.email"));
                ui.text_edit_singleline(&mut self.auth_email);
                ui.label(t("account.password"));
                ui.add(egui::TextEdit::singleline(&mut self.auth_password).password(true));
                if ui.button(t("account.sign_in")).clicked() {
                    self.start_login(ui.ctx());
                }
            }
        }
    }

    fn start_login(&mut self, ctx: &egui::Context) {
        let base = self.api_base.clone();
        let email = self.auth_email.clone();
        let password = self.auth_password.clone();
        let (sender, receiver) = std::sync::mpsc::channel();
        self.auth_rx = Some(receiver);
        self.auth_state = AuthState::Loading;
        let context = ctx.clone();
        std::thread::spawn(move || {
            let result = tokio::runtime::Builder::new_current_thread()
                .enable_all()
                .build()
                .map_err(|error| error.to_string())
                .and_then(|runtime| {
                    runtime
                        .block_on(async {
                            match api_client::ApiClient::new(&base) {
                                Ok(mut client) => client.login(&email, &password).await,
                                Err(error) => Err(error),
                            }
                        })
                        .map_err(|error| error.to_string())
                });
            let message = match result {
                Ok(session) => AuthMessage::Session(session),
                Err(error) => AuthMessage::Failed(error),
            };
            let _ = sender.send(message);
            context.request_repaint();
        });
    }

    fn about(&mut self, ui: &mut egui::Ui) {
        ui.heading(t("about.title"));
        ui.label(RichText::new(t("about.subtitle")).color(theme::TEXT_SECONDARY));
        ui.add_space(16.0);
        ui.label("App 0.1.0 · Rust · eframe/egui 0.37");
        ui.label(format!(
            "{} · {}",
            std::env::consts::OS,
            std::env::consts::ARCH
        ));
        ui.label(self.paths.logs.display().to_string());
    }
}

#[derive(Debug, Clone, serde::Serialize, serde::Deserialize)]
struct LayoutState {
    tree: Tree<Pane>,
    pane: Pane,
}

struct PaneBehavior<'a> {
    app: &'a mut DesktopApp,
}

impl Behavior<Pane> for PaneBehavior<'_> {
    fn tab_title_for_pane(&mut self, pane: &Pane) -> egui::WidgetText {
        t(pane.title_key()).into()
    }

    fn pane_ui(&mut self, ui: &mut egui::Ui, _tile_id: TileId, pane: &mut Pane) -> UiResponse {
        match pane {
            Pane::Dashboard => self.app.dashboard(ui),
            Pane::Library => self.app.library(ui),
            Pane::Activity => self.app.activity(ui),
            Pane::Settings => self.app.settings(ui),
            Pane::Account => self.app.account(ui),
            Pane::About => self.app.about(ui),
        }
        UiResponse::None
    }
}

fn stat(ui: &mut egui::Ui, label: String, value: String) {
    egui::Frame::new()
        .fill(theme::PANEL)
        .stroke(theme::BORDER_STROKE)
        .inner_margin(16.0)
        .show(ui, |ui| {
            ui.set_min_width(190.0);
            ui.label(RichText::new(label).small().color(theme::TEXT_SECONDARY));
            ui.heading(value);
        });
}

fn icon(pane: Pane) -> &'static str {
    match pane {
        Pane::Dashboard => "H",
        Pane::Library => "L",
        Pane::Activity => "!",
        Pane::Settings => "S",
        Pane::Account => "A",
        Pane::About => "?",
    }
}

fn t(key: &str) -> String {
    rust_i18n::t!(key).to_string()
}

#[cfg(test)]
mod tests {
    use super::*;
    use egui_kittest::Harness;
    use egui_kittest::kittest::Queryable;

    #[test]
    fn command_palette_navigates_and_names_controls() {
        let mut app = DesktopApp::for_tests();
        app.palette_open = true;

        let mut harness = Harness::new_ui_state(|ui, app| app.render(ui), app);
        harness.run();
        harness.get_by_label("Go to Library").click();
        harness.run();

        assert_eq!(harness.state().pane, Pane::Library);
    }
}
