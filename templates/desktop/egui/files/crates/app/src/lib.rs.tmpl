#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, serde::Serialize, serde::Deserialize)]
pub enum Pane {
    Dashboard,
    Library,
    Activity,
    Settings,
    Account,
    About,
}

impl Pane {
    fn title_key(self) -> &'static str {
        match self {
            Self::Dashboard => "dashboard.title",
            Self::Library => "library.title",
            Self::Activity => "activity.title",
            Self::Settings => "settings.title",
            Self::Account => "account.title",
            Self::About => "about.title",
        }
    }

    const fn icon(self) -> Icon {
        match self {
            Self::Dashboard => Icon::Dashboard,
            Self::Library => Icon::Library,
            Self::Activity => Icon::Activity,
            Self::Settings => Icon::Settings,
            Self::Account => Icon::Account,
            Self::About => Icon::About,
        }
    }

    /// Settings and About sit in the sidebar footer, below the workspace pages.
    const fn in_sidebar_footer(self) -> bool {
        matches!(self, Self::Settings | Self::About)
    }

    fn all(api_mode: bool) -> Vec<Self> {
        let mut panes = vec![
            Self::Dashboard,
            Self::Library,
            Self::Activity,
            Self::Settings,
        ];
        if api_mode {
            panes.push(Self::Account);
        }
        panes.push(Self::About);
        panes
    }
}

/// What the Library editor is showing.
#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
pub enum Editor {
    /// Nothing selected; the editor shows an empty state.
    #[default]
    Closed,
    /// A new, unsaved record.
    New,
    /// An existing record.
    Record(uuid::Uuid),
    /// A record that was selected but no longer exists (deleted elsewhere).
    Missing(uuid::Uuid),
}

impl Editor {
    /// The record being edited, if it already exists.
    #[must_use]
    pub const fn record(self) -> Option<uuid::Uuid> {
        match self {
            Self::Record(id) => Some(id),
            Self::Closed | Self::New | Self::Missing(_) => None,
        }
    }
}

/// A destructive action waiting for the user's confirmation.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Confirmation {
    /// Delete every local Library record.
    ClearLocalData,
}

#[derive(Debug, Clone)]
pub enum Action {
    Navigate(Pane),
    ToggleSidebar,
    ToggleTheme,
    SetTheme(ThemePreference),
    SearchChanged(String),
    Select(Option<uuid::Uuid>),
    NewRecord,
    SaveDraft,
    DeleteRecord,
    SetLanguage(String),
    OpenPalette,
    ClosePalette,
    RunCommand(Command),
    ToggleHighContrast,
    UndoDelete,
    /// Opens the welcome tour on its first page.
    ShowWelcome,
    /// Shows another page of the welcome tour.
    WelcomeGo(WelcomePage),
    /// Closes the welcome tour and remembers it was seen.
    CloseWelcome(WelcomeOutcome),
    /// Sets the interface size (zoom factor, clamped to [`theme::zoom::RANGE`]).
    SetZoom(f32),
    /// Reopens the database after a read failure.
    ReopenDatabase,
    /// Asks the user to confirm a destructive action.
    RequestConfirmation(Confirmation),
    /// Runs the pending confirmation.
    Confirm,
    /// Drops the pending confirmation.
    CancelConfirmation,
}

pub struct DesktopApp {
    pub app_name: String,
    pub paths: Paths,
    pub settings: Settings,
    pub settings_store: SettingsStore,
    pub database: Mutex<Database>,
    pub tree: Tree<Pane>,
    pub pane: Pane,
    pub search: String,
    pub editor: Editor,
    pub draft: LibraryDraft,
    pub toasts: egui_notify::Toasts,
    pub palette_open: bool,
    pub palette_query: String,
    pub palette_selection: usize,
    palette_needs_focus: bool,
    pub logging_guard: logging::LoggingGuard,
    pub last_deleted: Option<uuid::Uuid>,
    pub form_error: Option<String>,
    pub tokens: credentials::TokenStore,
    pub api_mode: bool,
    pub api_base: String,
    pub auth_state: AuthState,
    pub auth_email: String,
    pub auth_password: String,
    pub auth_rx: Option<std::sync::mpsc::Receiver<AuthMessage>>,
    pub access_token: Option<String>,
    pub sync_rx: Option<std::sync::mpsc::Receiver<sync::SyncReport>>,
    pub sync_status: String,
    /// The last sync's error, shown as a notice until the next sync.
    pub sync_error: Option<String>,
    /// A destructive action waiting for confirmation.
    pub confirmation: Option<Confirmation>,
    /// The welcome tour page on screen, if the tour is open.
    pub welcome: Option<WelcomePage>,
    /// Wakes the UI when background work finishes.
    repaint: Option<egui::Context>,
    applied_theme: Option<ThemeSettings>,
    resolved_theme: egui::Theme,
    applied_zoom: Option<f32>,
}

#[derive(Debug)]
pub enum AuthState {
    SignedOut,
    Loading,
    SignedIn(String),
    Failed(String),
}

pub enum AuthMessage {
    Session(api_client::ApiSession),
    Failed(String),
}

impl DesktopApp {
    /// Creates the window state, database, settings, and tiled workspace.
    ///
    /// # Errors
    ///
    /// Returns an error when paths, settings, migrations, or the database
    /// cannot be initialized.
    pub fn new(app_name: &str) -> anyhow::Result<Self> {
        let paths = Paths::discover(app_name)?;
        let settings_store = SettingsStore::new(&paths.config);
        let settings = settings_store.load()?;
        rust_i18n::set_locale(&settings.locale);
        let logging_guard = logging::init(&paths.logs, "info");
        let database = Database::open(&paths.data.join("local.sqlite"))?;
        let api_mode = std::env::var("SMOKEFORGE_API_MODE")
            .is_ok_and(|value| matches!(value.as_str(), "api" | "1" | "true"));
        if !api_mode {
            database.seed_if_empty()?;
        }
        let tree = Tree::new_tabs(egui::Id::unique("workspace"), Pane::all(api_mode));
        Ok(Self::with_parts(
            app_name,
            paths,
            settings,
            settings_store,
            database,
            tree,
            logging_guard,
            credentials::TokenStore::new("{{.bundle_id}}", "auth"),
            api_mode,
            std::env::var("SMOKEFORGE_API_URL")
                .unwrap_or_else(|_| "http://localhost:8080".to_owned()),
        ))
    }

    /// Builds a temporary app for UI tests.
    ///
    /// # Panics
    ///
    /// Panics if the temporary `SQLite` database cannot be created.
    #[cfg(test)]
    #[must_use]
    pub fn for_tests() -> Self {
        let root =
            std::env::temp_dir().join(format!("smokeforge-egui-test-{}", uuid::Uuid::new_v4()));
        let _ = std::fs::create_dir_all(root.join("data"));
        let _ = std::fs::create_dir_all(root.join("config"));
        let paths = Paths {
            data: root.join("data"),
            config: root.join("config"),
            logs: root.join("logs"),
        };
        let database = Database::open(&paths.data.join("local.sqlite"))
            .expect("temporary test database opens");
        database.seed_if_empty().expect("test database seeds");
        let tree = Tree::new_tabs(egui::Id::unique("workspace-test"), Pane::all(false));
        let settings_store = SettingsStore::new(&paths.config);
        // Tests start past the welcome tour; tour tests open it with ShowWelcome.
        let settings = Settings {
            onboarded: true,
            ..Settings::default()
        };
        Self::with_parts(
            "Test App",
            paths,
            settings,
            settings_store,
            database,
            tree,
            logging::LoggingGuard::disabled(),
            credentials::TokenStore::memory_only(),
            false,
            "http://localhost:8080".to_owned(),
        )
    }

    #[expect(
        clippy::too_many_arguments,
        reason = "private constructor shared by new and tests"
    )]
    fn with_parts(
        app_name: &str,
        paths: Paths,
        settings: Settings,
        settings_store: SettingsStore,
        database: Database,
        tree: Tree<Pane>,
        logging_guard: logging::LoggingGuard,
        tokens: credentials::TokenStore,
        api_mode: bool,
        api_base: String,
    ) -> Self {
        let welcome = (!settings.onboarded).then_some(WelcomePage::Intro);
        Self {
            app_name: app_name.to_owned(),
            paths,
            settings,
            settings_store,
            database: Mutex::new(database),
            tree,
            pane: Pane::Dashboard,
            search: String::new(),
            editor: Editor::Closed,
            draft: LibraryDraft::default(),
            toasts: egui_notify::Toasts::default(),
            palette_open: false,
            palette_query: String::new(),
            palette_selection: 0,
            palette_needs_focus: false,
            logging_guard,
            last_deleted: None,
            form_error: None,
            tokens,
            api_mode,
            api_base,
            auth_state: AuthState::SignedOut,
            auth_email: String::new(),
            auth_password: String::new(),
            auth_rx: None,
            access_token: None,
            sync_rx: None,
            sync_status: String::new(),
            sync_error: None,
            confirmation: None,
            welcome,
            repaint: None,
            applied_theme: None,
            resolved_theme: egui::Theme::Dark,
            applied_zoom: None,
        }
    }

    pub fn restore_layout(&mut self, storage: &dyn eframe::Storage) {
        if let Some(state) = eframe::get_value::<LayoutState>(storage, eframe::APP_KEY) {
            self.tree = state.tree;
            self.pane = state.pane;
        }
    }

    pub fn save_layout(&self, storage: &mut dyn eframe::Storage) {
        let state = LayoutState {
            tree: self.tree.clone(),
            pane: self.pane,
        };
        eframe::set_value(storage, eframe::APP_KEY, &state);
    }

    /// The theme the settings ask for.
    #[must_use]
    pub fn theme_settings(&self) -> ThemeSettings {
        ThemeSettings {
            preference: ThemePreference::from_setting(&self.settings.theme),
            contrast: if self.settings.high_contrast {
                Contrast::High
            } else {
                Contrast::Standard
            },
        }
    }

    #[allow(clippy::too_many_lines)]
    pub fn dispatch(&mut self, action: Action) {
        match action {
            Action::Navigate(pane) => {
                self.pane = pane;
                self.tree
                    .make_active(|_, tile| matches!(tile, Tile::Pane(p) if *p == pane));
            }
            Action::ToggleSidebar => self.settings.sidebar_open = !self.settings.sidebar_open,
            Action::ToggleTheme => {
                let next = match self.resolved_theme {
                    egui::Theme::Dark => ThemePreference::Light,
                    egui::Theme::Light => ThemePreference::Dark,
                };
                next.as_setting().clone_into(&mut self.settings.theme);
            }
            Action::SetTheme(preference) => {
                preference.as_setting().clone_into(&mut self.settings.theme);
            }
            Action::SearchChanged(search) => self.search = search,
            Action::Select(id) => {
                self.form_error = None;
                let item = id.and_then(|id| {
                    self.database
                        .lock()
                        .ok()
                        .and_then(|db| db.get(id).ok().flatten())
                });
                self.editor = match (id, &item) {
                    (None, _) => Editor::Closed,
                    (Some(id), Some(_)) => Editor::Record(id),
                    (Some(id), None) => Editor::Missing(id),
                };
                self.draft = item
                    .map(|item| LibraryDraft::from(&item))
                    .unwrap_or_default();
            }
            Action::NewRecord => {
                self.form_error = None;
                self.draft = LibraryDraft::default();
                self.dispatch(Action::Navigate(Pane::Library));
                self.editor = Editor::New;
            }
            Action::SaveDraft => self.save_draft(),
            Action::DeleteRecord => self.delete_record(),
            Action::SetLanguage(language) => {
                self.settings.language.clone_from(&language);
                self.settings.locale.clone_from(&language);
                rust_i18n::set_locale(&language);
            }
            Action::OpenPalette => {
                self.palette_open = true;
                self.palette_query.clear();
                self.palette_selection = 0;
                self.palette_needs_focus = true;
            }
            Action::ClosePalette => self.palette_open = false,
            Action::RunCommand(command) => self.run_command(command),
            Action::ToggleHighContrast => {
                self.settings.high_contrast = !self.settings.high_contrast;
            }
            Action::UndoDelete => self.undo_delete(),
            Action::ShowWelcome => self.welcome = Some(WelcomePage::Intro),
            Action::WelcomeGo(page) => self.welcome = Some(page),
            Action::CloseWelcome(outcome) => {
                self.welcome = None;
                self.settings.onboarded = true;
                tracing::info!(?outcome, "welcome tour closed");
            }
            Action::SetZoom(zoom) => {
                self.settings.zoom =
                    zoom.clamp(*theme::zoom::RANGE.start(), *theme::zoom::RANGE.end());
            }
            Action::ReopenDatabase => self.reopen_database(),
            Action::RequestConfirmation(confirmation) => self.confirmation = Some(confirmation),
            Action::CancelConfirmation => self.confirmation = None,
            Action::Confirm => {
                if let Some(Confirmation::ClearLocalData) = self.confirmation.take() {
                    match self.clear_local_data() {
                        Ok(count) => {
                            self.toasts.success(format!("Cleared {count} records."));
                        }
                        Err(error) => {
                            self.toasts.error(error);
                        }
                    }
                }
            }
        }
        let _ = self.settings_store.save(&self.settings);
    }

    fn save_draft(&mut self) {
        if let Err(report) = self.draft.validate() {
            self.form_error = Some(report.to_string());
            self.toasts
                .error("Fix the highlighted fields before saving.");
            return;
        }
        self.form_error = None;

        let Ok(database) = self.database.lock() else {
            self.toasts.error("The local database is unavailable.");
            return;
        };
        match self.editor {
            Editor::Record(id) => match database.update(id, &self.draft) {
                Ok(Some(item)) => {
                    Self::queue_outbox(&database, "update", &item);
                    self.toasts.success("Record saved.");
                }
                Ok(None) => {
                    self.toasts.error("Record not found.");
                }
                Err(error) => {
                    self.toasts.error(error.to_string());
                }
            },
            Editor::New | Editor::Closed | Editor::Missing(_) => match database.create(&self.draft)
            {
                Ok(item) => {
                    Self::queue_outbox(&database, "create", &item);
                    self.editor = Editor::Record(item.id);
                    self.toasts.success("Record created.");
                }
                Err(error) => {
                    self.toasts.error(error.to_string());
                }
            },
        }
    }

    fn delete_record(&mut self) {
        let Some(id) = self.editor.record() else {
            return;
        };
        let Ok(database) = self.database.lock() else {
            self.toasts.error("The local database is unavailable.");
            return;
        };
        match database.soft_delete(id) {
            Ok(true) => {
                if let Ok(Some(item)) = database.get(id) {
                    Self::queue_outbox(&database, "delete", &item);
                }
                self.last_deleted = Some(id);
                self.editor = Editor::Closed;
                self.draft = LibraryDraft::default();
                self.toasts
                    .success("Record deleted. Use Undo in the status bar.");
            }
            Ok(false) => {
                self.toasts.error("Record not found.");
            }
            Err(error) => {
                self.toasts.error(error.to_string());
            }
        }
    }

    fn undo_delete(&mut self) {
        let Some(id) = self.last_deleted.take() else {
            return;
        };
        let Ok(database) = self.database.lock() else {
            self.toasts.error("The local database is unavailable.");
            return;
        };
        match database.restore(id) {
            Ok(Some(item)) => {
                self.editor = Editor::Record(item.id);
                self.toasts.success("Record restored.");
            }
            Ok(None) => {
                self.toasts.error("Record no longer exists.");
            }
            Err(error) => {
                self.toasts.error(error.to_string());
            }
        }
    }

    pub fn render(&mut self, ui: &mut egui::Ui) {
        self.poll_auth();
        self.poll_sync();
        self.sync_theme(ui);
        self.sync_zoom(ui);
        self.handle_shortcuts(ui);
        egui_extras::install_image_loaders(ui.ctx());
        self.shell(ui);
    }

    /// Installs the theme when its settings changed and remembers which theme
    /// (light or dark) is on screen, including when following the system.
    fn sync_theme(&mut self, ui: &mut egui::Ui) {
        if self.repaint.is_none() {
            self.repaint = Some(ui.ctx().clone());
        }
        let wanted = self.theme_settings();
        if self.applied_theme != Some(wanted) {
            theme::apply_now(ui, wanted);
            self.applied_theme = Some(wanted);
        }
        self.resolved_theme = ui.ctx().theme();
    }

    /// Applies the interface size from settings. egui's own Ctrl +/− zoom is
    /// turned off so the setting stays the single source of truth;
    /// [`Self::handle_shortcuts`] maps those keys to [`Action::SetZoom`].
    fn sync_zoom(&mut self, ui: &egui::Ui) {
        let zoom = self
            .settings
            .zoom
            .clamp(*theme::zoom::RANGE.start(), *theme::zoom::RANGE.end());
        if self.applied_zoom != Some(zoom) {
            let ctx = ui.ctx();
            ctx.options_mut(|options| options.zoom_with_keyboard = false);
            ctx.set_zoom_factor(zoom);
            self.applied_zoom = Some(zoom);
        }
    }

    fn handle_shortcuts(&mut self, ui: &mut egui::Ui) {
        use egui::gui_zoom::kb_shortcuts::{ZOOM_IN, ZOOM_IN_SECONDARY, ZOOM_OUT, ZOOM_RESET};
        use shortcuts::{NEW_RECORD, PALETTE, SIDEBAR};
        use theme::zoom;

        let current = self.settings.zoom;
        if ui.input_mut(|input| input.consume_shortcut(&ZOOM_RESET)) {
            self.dispatch(Action::SetZoom(zoom::DEFAULT));
        } else if ui.input_mut(|input| {
            input.consume_shortcut(&ZOOM_IN) || input.consume_shortcut(&ZOOM_IN_SECONDARY)
        }) {
            self.dispatch(Action::SetZoom(components::step_value(
                current,
                zoom::STEP,
                &zoom::RANGE,
            )));
        } else if ui.input_mut(|input| input.consume_shortcut(&ZOOM_OUT)) {
            self.dispatch(Action::SetZoom(components::step_value(
                current,
                -zoom::STEP,
                &zoom::RANGE,
            )));
        }

        if ui.input_mut(|input| input.consume_shortcut(&PALETTE)) {
            if self.palette_open {
                self.dispatch(Action::ClosePalette);
            } else {
                self.dispatch(Action::OpenPalette);
            }
        }
        if ui.input_mut(|input| input.consume_shortcut(&NEW_RECORD)) {
            self.dispatch(Action::NewRecord);
        }
        if ui.input_mut(|input| input.consume_shortcut(&SIDEBAR)) {
            self.dispatch(Action::ToggleSidebar);
        }
    }

    fn run_command(&mut self, command: Command) {
        match command {
            Command::Navigate(pane) => self.dispatch(Action::Navigate(pane)),
            Command::NewRecord => self.dispatch(Action::NewRecord),
            Command::ToggleSidebar => self.dispatch(Action::ToggleSidebar),
            Command::ToggleTheme => self.dispatch(Action::ToggleTheme),
            Command::ToggleHighContrast => self.dispatch(Action::ToggleHighContrast),
            Command::ShowWelcome => self.dispatch(Action::ShowWelcome),
        }
    }

    /// Library records matching `search`, or why they could not be read.
    pub(crate) fn records(&self, search: &str) -> Result<Vec<domain::LibraryItem>, String> {
        let database = self
            .database
            .lock()
            .map_err(|_| "The database lock was poisoned by an earlier crash.".to_owned())?;
        database
            .list(search, None)
            .map_err(|error| error.to_string())
    }

    fn reopen_database(&mut self) {
        match Database::open(&self.paths.data.join("local.sqlite")) {
            Ok(database) => {
                self.database = Mutex::new(database);
                self.toasts.success("Database reopened.");
            }
            Err(error) => {
                self.toasts.error(format!("Still unavailable: {error}"));
            }
        }
    }

    /// Whether a sync is running in the background.
    #[must_use]
    pub fn is_syncing(&self) -> bool {
        self.sync_rx.is_some()
    }

    fn export_library(&self, path: &std::path::Path) -> Result<(), String> {
        let database = self
            .database
            .lock()
            .map_err(|_| "database lock".to_owned())?;
        let raw = database.export_json().map_err(|error| error.to_string())?;
        std::fs::write(path, raw).map_err(|error| error.to_string())
    }

    fn import_library(&self, path: &std::path::Path) -> Result<usize, String> {
        let raw = std::fs::read_to_string(path).map_err(|error| error.to_string())?;
        let database = self
            .database
            .lock()
            .map_err(|_| "database lock".to_owned())?;
        database
            .import_json(&raw)
            .map_err(|error| error.to_string())
    }

    fn backup_database(&self, path: &std::path::Path) -> Result<(), String> {
        let database = self
            .database
            .lock()
            .map_err(|_| "database lock".to_owned())?;
        database.backup(path).map_err(|error| error.to_string())
    }

    fn resolve_conflict(&self, item_id: &str, keep_local: bool) -> Result<(), String> {
        let database = self
            .database
            .lock()
            .map_err(|_| "database lock".to_owned())?;
        if keep_local {
            database
                .resolve_conflict_local(item_id)
                .map_err(|error| error.to_string())
        } else {
            database
                .resolve_conflict_remote(item_id)
                .map_err(|error| error.to_string())
        }
    }

    fn clear_local_data(&self) -> Result<usize, String> {
        let database = self
            .database
            .lock()
            .map_err(|_| "database lock".to_owned())?;
        database.clear_library().map_err(|error| error.to_string())
    }

    fn queue_outbox(
        database: &{{.crate_name}}_storage::Database,
        operation: &str,
        item: &{{.crate_name}}_core::LibraryItem,
    ) {
        let key = format!("{operation}-{}", uuid::Uuid::new_v4());
        if let Ok(payload) = serde_json::to_string(item) {
            let _ = database.enqueue_outbox(&key, &item.id.to_string(), operation, &payload, &key);
        }
    }

    fn poll_auth(&mut self) {
        let Some(receiver) = &self.auth_rx else {
            return;
        };
        while let Ok(message) = receiver.try_recv() {
            match message {
                AuthMessage::Session(session) => {
                    self.tokens.set(&session.refresh_token).ok();
                    self.access_token = Some(session.access_token);
                    self.auth_state = AuthState::SignedIn(self.auth_email.clone());
                    self.auth_password.clear();
                }
                AuthMessage::Failed(error) => {
                    self.auth_state = AuthState::Failed(error);
                }
            }
        }
    }

    fn poll_sync(&mut self) {
        let Some(receiver) = &self.sync_rx else {
            return;
        };
        let Ok(report) = receiver.try_recv() else {
            return;
        };
        self.sync_rx = None;
        self.sync_status = format!(
            "Synced {} · conflicts {} · retried {}",
            report.pushed, report.conflicts, report.retried
        );
        self.sync_error = report.error;
    }

    fn start_sync(&mut self) {
        let Some(token) = self.access_token.clone() else {
            "Sign in before syncing.".clone_into(&mut self.sync_status);
            return;
        };
        let (sender, receiver) = std::sync::mpsc::channel();
        self.sync_rx = Some(receiver);
        self.sync_error = None;
        let path = self.paths.data.join("local.sqlite");
        let base = self.api_base.clone();
        let context = self.repaint.clone();
        std::thread::spawn(move || {
            let report = sync::run(&path, &base, token);
            let _ = sender.send(report);
            if let Some(context) = context {
                context.request_repaint();
            }
        });
    }

    fn start_login(&mut self, ctx: &egui::Context) {
        let base = self.api_base.clone();
        let email = self.auth_email.clone();
        let password = self.auth_password.clone();
        let (sender, receiver) = std::sync::mpsc::channel();
        self.auth_rx = Some(receiver);
        self.auth_state = AuthState::Loading;
        let context = ctx.clone();
        std::thread::spawn(move || {
            let result = tokio::runtime::Builder::new_current_thread()
                .enable_all()
                .build()
                .map_err(|error| error.to_string())
                .and_then(|runtime| {
                    runtime
                        .block_on(async {
                            match api_client::ApiClient::new(&base) {
                                Ok(mut client) => client.login(&email, &password).await,
                                Err(error) => Err(error),
                            }
                        })
                        .map_err(|error| error.to_string())
                });
            let message = match result {
                Ok(session) => AuthMessage::Session(session),
                Err(error) => AuthMessage::Failed(error),
            };
            let _ = sender.send(message);
            context.request_repaint();
        });
    }
}

#[derive(Debug, Clone, serde::Serialize, serde::Deserialize)]
struct LayoutState {
    tree: Tree<Pane>,
    pane: Pane,
}

fn t(key: &str) -> String {
    rust_i18n::t!(key).to_string()
}

#[cfg(test)]
mod tests {
    use super::*;
    use egui_kittest::Harness;
    use egui_kittest::kittest::Queryable;

    fn harness(app: DesktopApp) -> Harness<'static, DesktopApp> {
        let mut harness = Harness::builder()
            .with_size(egui::vec2(1180.0, 760.0))
            .build_ui_state(|ui, app: &mut DesktopApp| app.render(ui), app);
        harness.run();
        harness
    }

    #[test]
    fn go_to_navigates_and_names_controls() {
        let mut app = DesktopApp::for_tests();
        app.dispatch(Action::OpenPalette);

        let mut harness = harness(app);
        // Sidebar items are tabs; "Go to…" rows are list-box options.
        harness
            .get_by_role_and_label(egui::Role::ListBoxOption, "Library")
            .click();
        harness.run();

        assert_eq!(harness.state().pane, Pane::Library);
        assert!(
            !harness.state().palette_open,
            "choosing a row closes Go to…"
        );
    }

    #[test]
    fn sidebar_search_opens_go_to_and_finds_records() {
        let mut harness = harness(DesktopApp::for_tests());
        harness
            .get_by_role_and_label(egui::Role::Button, "Go to…")
            .click();
        harness.run();
        assert!(harness.state().palette_open);

        let title = harness
            .state()
            .records("")
            .expect("seeded records")
            .first()
            .expect("at least one seeded record")
            .title
            .clone();
        harness.state_mut().palette_query.clone_from(&title);
        harness.run();
        harness
            .get_by_role_and_label(egui::Role::ListBoxOption, &title)
            .click();
        harness.run();

        assert_eq!(harness.state().pane, Pane::Library);
        assert!(matches!(harness.state().editor, Editor::Record(_)));
    }

    #[test]
    fn sidebar_items_are_named_and_navigate() {
        let mut harness = harness(DesktopApp::for_tests());
        // The workspace tab is also called "Settings"; the sidebar item is a Tab role.
        harness
            .get_by_role_and_label(egui::Role::Tab, "Settings")
            .click();
        harness.run();
        assert_eq!(harness.state().pane, Pane::Settings);
    }

    #[test]
    fn new_record_opens_an_empty_editor() {
        let mut app = DesktopApp::for_tests();
        app.dispatch(Action::NewRecord);
        let harness = harness(app);

        assert_eq!(harness.state().pane, Pane::Library);
        assert_eq!(harness.state().editor, Editor::New);
        harness.get_by_label("Title");
    }

    #[test]
    fn title_bar_theme_button_switches_theme() {
        let mut app = DesktopApp::for_tests();
        app.dispatch(Action::SetTheme(ThemePreference::Dark));
        let mut harness = harness(app);
        assert_eq!(harness.ctx.theme(), egui::Theme::Dark);

        harness.get_by_label("Switch to light theme").click();
        harness.run();

        assert_eq!(harness.state().settings.theme, "light");
        assert_eq!(harness.ctx.theme(), egui::Theme::Light);
    }

    #[test]
    fn theme_is_applied_once_and_follows_settings() {
        let mut app = DesktopApp::for_tests();
        app.dispatch(Action::SetTheme(ThemePreference::Light));
        let mut harness = harness(app);
        assert_eq!(harness.ctx.theme(), egui::Theme::Light);

        harness.state_mut().dispatch(Action::ToggleHighContrast);
        harness.run();
        assert_eq!(
            theme::palette(&harness.ctx),
            theme::Palette::for_theme(egui::Theme::Light, Contrast::High)
        );
    }

    #[test]
    fn welcome_tour_walks_forward_and_back_then_finishes() {
        let mut app = DesktopApp::for_tests();
        app.dispatch(Action::ShowWelcome);
        let mut harness = harness(app);
        assert!(harness.query_by_label("Skip the tour").is_some());

        harness.get_by_label("Next").click();
        harness.run();
        assert_eq!(harness.state().welcome, Some(WelcomePage::Shortcuts));

        harness.get_by_label("Back").click();
        harness.run();
        assert_eq!(harness.state().welcome, Some(WelcomePage::Intro));

        harness.get_by_label("Next").click();
        harness.run();
        harness.get_by_label("Next").click();
        harness.run();
        harness.get_by_label("Get started").click();
        harness.run();
        assert_eq!(harness.state().welcome, None);
        assert!(harness.state().settings.onboarded);
    }

    #[test]
    fn escape_skips_the_welcome_tour_and_remembers_it() {
        let mut app = DesktopApp::for_tests();
        app.settings.onboarded = false;
        app.dispatch(Action::ShowWelcome);
        let mut harness = harness(app);

        harness.key_press(egui::Key::Escape);
        harness.run();
        assert_eq!(harness.state().welcome, None);
        assert!(harness.state().settings.onboarded);
        assert!(harness.query_by_label("Skip the tour").is_none());
    }

    #[test]
    fn welcome_size_stepper_changes_the_zoom() {
        let mut app = DesktopApp::for_tests();
        app.dispatch(Action::ShowWelcome);
        let mut harness = harness(app);

        harness
            .get_all_by_label("Make the interface larger")
            .next()
            .expect("size stepper is visible")
            .click();
        harness.run();
        assert!((harness.state().settings.zoom - 1.1).abs() < f32::EPSILON);
        assert!((harness.ctx.zoom_factor() - 1.1).abs() < f32::EPSILON);
    }

    #[test]
    fn zoom_is_clamped_to_its_range() {
        let mut app = DesktopApp::for_tests();
        app.dispatch(Action::SetZoom(9.0));
        assert!((app.settings.zoom - *theme::zoom::RANGE.end()).abs() < f32::EPSILON);
        app.dispatch(Action::SetZoom(0.1));
        assert!((app.settings.zoom - *theme::zoom::RANGE.start()).abs() < f32::EPSILON);
    }
}
