#![cfg_attr(not(debug_assertions), windows_subsystem = "windows")]

use std::io::{Read, Write};
use std::net::{TcpListener, TcpStream};
use std::sync::Arc;
use std::sync::atomic::{AtomicBool, Ordering};

use eframe::egui;

fn main() -> eframe::Result<()> {
    install_panic_hook();
    if forward_to_running_instance() {
        return Ok(());
    }
    let (focus, _listener) = start_instance_listener();

    let icon = eframe::icon_data::from_png_bytes(include_bytes!("../../../assets/icon.png"))
        .expect("embedded application icon");
    let mut viewport = egui::ViewportBuilder::default()
        .with_inner_size([1180.0, 760.0])
        .with_min_inner_size([760.0, 520.0])
        .with_title("{{.project_name}}")
        .with_app_id("{{.bundle_id}}")
        .with_icon(icon);

    if cfg!(target_os = "macos") {
        viewport = viewport
            .with_titlebar_shown(false)
            .with_fullsize_content_view(true)
            .with_titlebar_buttons_shown(true);
    } else {
        viewport = viewport.with_decorations(false);
    }

    let options = eframe::NativeOptions {
        viewport,
        ..Default::default()
    };

    eframe::run_native(
        "{{.project_name}}",
        options,
        Box::new(|cc| {
            {{.crate_name}}_app::theme::install_fonts(&cc.egui_ctx);
            let mut screen = Screen::start();
            if let (Screen::App(app), Some(storage)) = (&mut screen, cc.storage) {
                app.restore_layout(storage);
            }

            Ok(Box::new(DesktopShell { screen, focus }))
        }),
    )
}

fn install_panic_hook() {
    let path = std::env::temp_dir().join("{{.crate_name}}-panic.log");
    let default_hook = std::panic::take_hook();
    std::panic::set_hook(Box::new(move |info| {
        let report = format!("{info}\n");
        let _ = std::fs::write(&path, report);
        // Keep the standard stderr report so panics show up in `make dev`.
        default_hook(info);
    }));
}

fn instance_path() -> std::path::PathBuf {
    std::env::temp_dir().join("{{.crate_name}}-instance.port")
}

fn forward_to_running_instance() -> bool {
    let Ok(port) = std::fs::read_to_string(instance_path()) else {
        return false;
    };
    let Ok(mut stream) = TcpStream::connect(("127.0.0.1", port.trim().parse::<u16>().unwrap_or(0)))
    else {
        return false;
    };
    let args = std::env::args().skip(1).collect::<Vec<_>>().join("\u{0}");
    stream.write_all(args.as_bytes()).is_ok()
}

fn start_instance_listener() -> (Arc<AtomicBool>, Option<std::thread::JoinHandle<()>>) {
    let focus = Arc::new(AtomicBool::new(false));
    let Ok(listener) = TcpListener::bind(("127.0.0.1", 0)) else {
        return (focus, None);
    };
    let Ok(address) = listener.local_addr() else {
        return (focus, None);
    };
    let _ = std::fs::write(instance_path(), address.port().to_string());
    let signal = Arc::clone(&focus);
    let handle = std::thread::spawn(move || {
        for mut stream in listener.incoming().flatten() {
            let mut args = String::new();
            let _ = stream.read_to_string(&mut args);
            signal.store(true, Ordering::Relaxed);
        }
    });

    (focus, Some(handle))
}

/// What the window shows: the app, or why it could not start.
enum Screen {
    App(Box<{{.crate_name}}_app::DesktopApp>),
    Failed({{.crate_name}}_app::startup::StartupFailure),
}

impl Screen {
    fn start() -> Self {
        match {{.crate_name}}_app::DesktopApp::new("{{.project_name}}") {
            Ok(app) => Self::App(Box::new(app)),
            Err(error) => {
                let logs = {{.crate_name}}_app::startup::logs_folder("{{.project_name}}");
                Self::Failed({{.crate_name}}_app::startup::StartupFailure::new(
                    format!("{error:#}"),
                    logs,
                ))
            }
        }
    }
}

struct DesktopShell {
    screen: Screen,
    focus: Arc<AtomicBool>,
}

impl eframe::App for DesktopShell {
    fn ui(&mut self, ui: &mut egui::Ui, _frame: &mut eframe::Frame) {
        if self.focus.swap(false, Ordering::Relaxed) {
            ui.ctx().send_viewport_cmd(egui::ViewportCommand::Focus);
        }
        let action = match &mut self.screen {
            Screen::App(app) => {
                app.render(ui);
                None
            }
            Screen::Failed(failure) => failure.show(ui),
        };
        match action {
            Some({{.crate_name}}_app::startup::StartupAction::Retry) => {
                self.screen = Screen::start()
            }
            Some({{.crate_name}}_app::startup::StartupAction::Quit) => {
                ui.ctx().send_viewport_cmd(egui::ViewportCommand::Close);
            }
            None => {}
        }
    }

    fn save(&mut self, storage: &mut dyn eframe::Storage) {
        if let Screen::App(app) = &self.screen {
            app.save_layout(storage);
        }
    }
}
