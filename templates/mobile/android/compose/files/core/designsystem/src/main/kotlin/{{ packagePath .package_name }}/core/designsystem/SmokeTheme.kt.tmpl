package {{.package_name}}.core.designsystem

import androidx.compose.foundation.isSystemInDarkTheme
import androidx.compose.material3.MaterialTheme
import androidx.compose.material3.Typography
import androidx.compose.material3.darkColorScheme
import androidx.compose.material3.lightColorScheme
import androidx.compose.runtime.Composable
import androidx.compose.ui.graphics.Color

object SmokeColors {
    val Ink = Color(0xFF0E0F11)
    val Chalk = Color(0xFFE7E8EA)
    val Signal = Color(0xFF4D8DFF)
    val Graphite = Color(0xFF24262B)
    val Mist = Color(0xFFF4F5F7)
}

private val DarkScheme = darkColorScheme(
    primary = SmokeColors.Signal,
    onPrimary = SmokeColors.Ink,
    primaryContainer = SmokeColors.Graphite,
    onPrimaryContainer = SmokeColors.Chalk,
    background = SmokeColors.Ink,
    onBackground = SmokeColors.Chalk,
    surface = SmokeColors.Graphite,
    onSurface = SmokeColors.Chalk,
    surfaceVariant = Color(0xFF30333A),
    onSurfaceVariant = Color(0xFFBFC3CB),
    outline = Color(0xFF6D727C),
    error = Color(0xFFFFB4AB),
)

private val LightScheme = lightColorScheme(
    primary = Color(0xFF2059B8),
    onPrimary = Color.White,
    primaryContainer = Color(0xFFD9E2FF),
    onPrimaryContainer = Color(0xFF001945),
    background = SmokeColors.Mist,
    onBackground = SmokeColors.Ink,
    surface = Color.White,
    onSurface = SmokeColors.Ink,
    surfaceVariant = Color(0xFFE3E5EA),
    onSurfaceVariant = Color(0xFF454850),
    outline = Color(0xFF767A83),
    error = Color(0xFFBA1A1A),
)

private val SmokeTypography = Typography()

@Composable
fun SmokeTheme(
    darkTheme: Boolean = isSystemInDarkTheme(),
    content: @Composable () -> Unit,
) {
    MaterialTheme(
        colorScheme = if (darkTheme) DarkScheme else LightScheme,
        typography = SmokeTypography,
        content = content,
    )
}
