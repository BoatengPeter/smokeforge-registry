plugins {
    id("smoke.android.application")
    id("smoke.android.compose")
    id("smoke.android.hilt")
}

val stagingApiBaseUrl = providers.gradleProperty("stagingApiBaseUrl")
    .getOrElse("https://staging.example.com")
val releaseApiBaseUrl = providers.gradleProperty("releaseApiBaseUrl")
    .getOrElse("https://api.example.com")

android {
    namespace = "{{.package_name}}"

    defaultConfig {
        applicationId = "{{.application_id}}"
    }

    buildTypes {
        debug {
            applicationIdSuffix = ".debug"
            versionNameSuffix = "-debug"
            buildConfigField("String", "API_BASE_URL", "\"{{.api_base_url}}\"")
            buildConfigField("String", "ENVIRONMENT", "\"debug\"")
        }

        create("staging") {
            initWith(getByName("debug"))
            applicationIdSuffix = ".staging"
            versionNameSuffix = "-staging"
            buildConfigField("String", "API_BASE_URL", "\"$stagingApiBaseUrl\"")
            buildConfigField("String", "ENVIRONMENT", "\"staging\"")
        }

        release {
            isMinifyEnabled = true
            isShrinkResources = true
            proguardFiles(
                getDefaultProguardFile("proguard-android-optimize.txt"),
                "proguard-rules.pro",
            )
            buildConfigField("String", "API_BASE_URL", "\"$releaseApiBaseUrl\"")
            buildConfigField("String", "ENVIRONMENT", "\"release\"")
        }
    }

    buildFeatures {
        buildConfig = true
    }
}

val keystorePath = providers.environmentVariable("SMOKE_KEYSTORE_PATH").orNull
if (keystorePath != null) {
    android.signingConfigs {
        create("release") {
            storeFile = file(keystorePath)
            storePassword = providers.environmentVariable("SMOKE_KEYSTORE_PASSWORD").orNull
            keyAlias = providers.environmentVariable("SMOKE_KEY_ALIAS").orNull
            keyPassword = providers.environmentVariable("SMOKE_KEY_PASSWORD").orNull
        }
    }
    android.buildTypes.named("release") {
        signingConfig = android.signingConfigs.getByName("release")
    }
}

